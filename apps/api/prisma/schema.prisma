generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COACH
  STUDENT
}

enum UserStatus {
  ACTIVE
  PENDING
  ARCHIVED
  DELETED
}

enum ReferralSource {
  ADS
  FRIEND
  SCHOOL
  OTHER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CoachTitle {
  NONE
  CM
  FM
  IM
  GM
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  IN_PROGRESS
}

enum AttendanceStatus {
  PRESENT
  LATE
  PARTIAL
  ABSENT
}

enum AttendanceEventType {
  JOIN
  LEAVE
  DISCONNECT
  RECONNECT
}

enum AssignmentDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

//
// USER
//

model User {
  id String @id @default(cuid())

  email    String  @unique
  username String? @unique
  password String

  firstName String
  lastName  String?

  phoneNumber String?

  avatarUrl String?

  role   UserRole   @default(STUDENT)
  status UserStatus @default(PENDING)

  timezone String @default("Asia/Kolkata")

  isEmailVerified Boolean @default(false)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdById  String?
  createdBy    User?   @relation("UserCreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedUsers")

  studentProfile         StudentProfile?
  coachProfile           CoachProfile?            @relation("UserCoachProfile")
  approvedCoaches        CoachProfile[]           @relation("CoachApprovedBy")
  createdBatches         Batch[]                  @relation("BatchCreatedBy")
  coachedBatches         BatchCoach[]             @relation("BatchCoaches")
  studentBatches         BatchStudent[]           @relation("BatchStudents")
  classes                CoachClass[]             @relation("ClassCoach")
  authSessions           AuthSession[]
  passwordResets         PasswordResetToken[]
  emailVerifications     EmailVerificationToken[]
  deletedRecords         TrashAuditLog[]          @relation("TrashAuditDeletedBy")
  deletedStudentProfiles StudentProfile[]         @relation("StudentProfileDeletedBy")
  deletedCoachProfiles   CoachProfile[]           @relation("CoachProfileDeletedBy")
  deletedBatches         Batch[]                  @relation("BatchDeletedBy")
  deletedBatchCoaches    BatchCoach[]             @relation("BatchCoachDeletedBy")
  deletedBatchStudents   BatchStudent[]           @relation("BatchStudentDeletedBy")
  liveSessions           LiveSession[]            @relation("LiveClassCoach")
  courseProgress         StudentCourseProgress[]  @relation("StudentCourseProgress")
  practices              StudentPractice[]        @relation("StudentPractice")
  authoredAssignments    Assignment[]             @relation("AuthoredAssignments")
  deployedAssignments    AssignmentBatch[]        @relation("DeployedAssignments")
  studentAssignments     StudentAssignment[]      @relation("StudentAssignments")
  activities             StudentActivity[]        @relation("StudentActivity")
  classAttendances       ClassAttendance[]
  attendanceLogs         AttendanceLog[]          @relation("UserAttendanceLogs")
  coachAttendances       CoachAttendance[]        @relation("CoachClassAttendance")
  coachAttendanceLogs    CoachAttendanceLog[]     @relation("UserCoachAttendanceLogs")
  chatMessages           LiveChatMessage[]        @relation("UserLiveChatMessages")

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  isDeleted                Boolean                  @default(false)
  deletedAt                DateTime?
  deletedById              String?
  deletedBy                User?                    @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedUsers             User[]                   @relation("UserDeletedBy")
  deleteGroupId            String?
  recordingWatchProgresses RecordingWatchProgress[]

  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("users")
}

//
// STUDENT PROFILE
//

model StudentProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth DateTime?

  chessRating Int?
  fideId      String?

  experienceLevel ExperienceLevel @default(BEGINNER)
  referralSource  ReferralSource  @default(OTHER)

  parentName  String
  parentEmail String?
  parentPhone String?

  parentRelationship String?

  enrolledAt DateTime @default(now())

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("StudentProfileDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("student_profiles")
}

//
// COACH PROFILE
//

model CoachProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("UserCoachProfile", fields: [userId], references: [id], onDelete: Cascade)

  title CoachTitle @default(NONE)

  bio String?

  qualification String?

  fideId     String?
  fideRating Int?

  specialization String?

  yearsOfExperience Int?

  hourlyRate Decimal? @db.Decimal(10, 2)

  approvalStatus UserStatus @default(PENDING)

  approvedById String?
  approvedBy   User?   @relation("CoachApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("CoachProfileDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("coach_profiles")
}

//
// AUTH SESSION
//

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

//
// BATCHES
//

model Batch {
  id String @id @default(cuid())

  name          String
  description   String?
  scheduleNotes String?

  status BatchStatus @default(ACTIVE)

  startsAt DateTime? @db.Date
  endsAt   DateTime? @db.Date

  createdById String?
  createdBy   User?   @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  coaches      BatchCoach[]
  students     BatchStudent[]
  classes      CoachClass[]
  liveSessions LiveSession[]
  assignments  AssignmentBatch[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("BatchDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([status])
  @@index([createdById])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("batches")
}

model BatchCoach {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("BatchCoaches", fields: [coachId], references: [id], onDelete: Cascade)

  assignedAt    DateTime  @default(now())
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("BatchCoachDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@unique([batchId, coachId])
  @@index([coachId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("batch_coaches")
}

model BatchStudent {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("BatchStudents", fields: [studentId], references: [id], onDelete: Cascade)

  enrolledAt    DateTime  @default(now())
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("BatchStudentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("batch_students")
}

model TrashAuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  user      User?    @relation("TrashAuditDeletedBy", fields: [userId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("trash_audit_logs")
}

//
// CLASSES
//

model CoachClass {
  id String @id @default(cuid())

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("ClassCoach", fields: [coachId], references: [id], onDelete: Cascade)

  isDemo Boolean @default(false)

  title       String?
  topic       String?
  description String?
  objectives  String?
  homework    String?
  notes       String?

  status ClassStatus @default(SCHEDULED)

  startsAt DateTime
  endsAt   DateTime

  meetingRoomId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  liveSession              LiveSession?             @relation("LiveSessionSchedule")
  attendances              ClassAttendance[]
  coachAttendance          CoachAttendance?
  recordingWatchProgresses RecordingWatchProgress[]

  @@index([batchId])
  @@index([coachId])
  @@index([status])
  @@index([startsAt])
  @@index([isDemo])
  @@map("classes")
}

model ClassAttendance {
  id String @id @default(cuid())

  classId String
  class   CoachClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status   AttendanceStatus @default(PRESENT)
  joinedAt DateTime?        @default(now())
  leftAt   DateTime?

  totalDuration     Int? // Total seconds actually in class
  attendancePercent Float? // 0-100 calculated percentage
  reconnectCount    Int       @default(0)
  lastActivity      DateTime?

  logs AttendanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("class_attendance")
}

model AttendanceLog {
  id String @id @default(cuid())

  attendanceId String
  attendance   ClassAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserAttendanceLogs", fields: [userId], references: [id], onDelete: Cascade)

  eventType AttendanceEventType
  timestamp DateTime            @default(now())

  sessionStart    DateTime?
  sessionEnd      DateTime?
  sessionDuration Int? // seconds for this segment

  reason    String? // disconnect reason from LiveKit
  userAgent String?
  ipAddress String?
  source    String  @default("LIVEKIT") // LIVEKIT, MANUAL, SYSTEM

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
  // Serves the "find the still-open session" lookup on every join/leave webhook.
  @@index([attendanceId, eventType, sessionEnd], map: "attendance_logs_open_session_idx")
  @@map("attendance_logs")
}

model CoachAttendance {
  id String @id @default(cuid())

  classId String     @unique
  class   CoachClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("CoachClassAttendance", fields: [coachId], references: [id], onDelete: Cascade)

  status   AttendanceStatus @default(PRESENT)
  joinedAt DateTime?        @default(now())
  leftAt   DateTime?

  totalDuration  Int? // Total seconds coach was in class
  boardDuration  Int? // Total seconds board was active in this class
  reconnectCount Int       @default(0)
  lastActivity   DateTime?

  logs CoachAttendanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId])
  @@index([status])
  @@map("coach_attendance")
}

model CoachAttendanceLog {
  id String @id @default(cuid())

  attendanceId String
  attendance   CoachAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserCoachAttendanceLogs", fields: [userId], references: [id], onDelete: Cascade)

  eventType String // JOIN, LEAVE, DISCONNECT, RECONNECT, BOARD_JOIN, BOARD_LEAVE
  timestamp DateTime @default(now())

  sessionStart    DateTime?
  sessionEnd      DateTime?
  sessionDuration Int? // seconds for this segment

  reason    String? // disconnect reason
  userAgent String?
  ipAddress String?
  source    String  @default("LIVEKIT") // LIVEKIT, MANUAL, SYSTEM

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
  @@map("coach_attendance_logs")
}

model AttendancePolicy {
  id String @id @default(cuid())

  name     String  @default("Default Policy")
  isActive Boolean @default(true)

  presentThreshold Float @default(90)
  lateThreshold    Float @default(70)
  partialThreshold Float @default(30)

  gracePeriodMinutes Int @default(5)
  minDurationMinutes Int @default(5)
  reconnectTolerance Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendance_policies")
}

//
// LIVE CLASSES
//

model LiveSession {
  id String @id @default(cuid())

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("LiveClassCoach", fields: [coachId], references: [id], onDelete: Cascade)

  classId String     @unique
  class   CoachClass @relation("LiveSessionSchedule", fields: [classId], references: [id], onDelete: Cascade)

  roomName        String  @unique
  livekitRoomName String? @unique

  status String @default("SCHEDULED") // SCHEDULED, WAITING, LIVE, ENDED, CANCELLED

  scheduledAt  DateTime
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?

  attendanceFinalizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metadata Json?

  chatMessages             LiveChatMessage[]
  recordingWatchProgresses RecordingWatchProgress[]

  @@index([batchId])
  @@index([coachId])
  @@index([status])
  @@map("live_sessions")
}

model LiveChatMessage {
  id String @id @default(cuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("UserLiveChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  senderName String
  senderRole String?

  message String @db.Text

  /// LiveKit's message id, so history reconciliation dedupes on identity
  /// instead of senderName+text+timestamp — which dropped a legitimately
  /// repeated short message (AUDIT M24).
  clientMessageId String?

  createdAt DateTime @default(now())

  @@index([liveSessionId])
  @@index([senderId])
  @@index([createdAt])
  @@index([clientMessageId])
  @@map("live_chat_messages")
}

/// Dedupe key for LiveKit webhook deliveries. LiveKit retries webhooks, and
/// without this a retried `participant_joined` / `participant_left` produced
/// duplicate RECONNECT logs and inflated durations (AUDIT M1).
model ProcessedWebhookEvent {
  id          String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("processed_webhook_events")
}

//
// COURSES
//

model Course {
  id          String                  @id @default(cuid())
  title       String
  description String?
  modules     CourseModule[]
  progress    StudentCourseProgress[]
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
}

model StudentCourseProgress {
  id              String   @id @default(cuid())
  studentId       String
  student         User     @relation("StudentCourseProgress", fields: [studentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercent Int      @default(0)
  lastOpenedAt    DateTime @default(now())

  @@unique([studentId, courseId])
  @@map("student_course_progress")
}

//
// PRACTICE & ASSIGNMENTS
//

model Practice {
  id         String            @id @default(cuid())
  title      String
  difficulty String // BEGINNER, INTERMEDIATE, ADVANCED
  dueDate    DateTime
  students   StudentPractice[]
}

model StudentPractice {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation("StudentPractice", fields: [studentId], references: [id], onDelete: Cascade)
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  status     String // PENDING, IN_PROGRESS, COMPLETED

  @@unique([studentId, practiceId])
  @@map("student_practices")
}

// A reusable PGN assignment in the library. Admins author shared items
// (`isLibrary = true`, visible to every coach); coaches author private items
// (`isLibrary = false`, visible only to the author). Not soft-deletable — a
// delete cascades to every deployment + per-student row.
model Assignment {
  id               String               @id @default(cuid())
  createdById      String?
  createdBy        User?                @relation("AuthoredAssignments", fields: [createdById], references: [id], onDelete: SetNull)
  isLibrary        Boolean              @default(false)
  title            String
  description      String?
  pgn              String // raw PGN text (source of truth for the board viewer)
  pgnUrl           String? // Cloudinary raw-file URL for download
  difficulty       AssignmentDifficulty @default(BEGINNER)
  timeLimitMinutes Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  deployments AssignmentBatch[]

  @@index([createdById])
  @@index([isLibrary])
  @@map("assignments")
}

// One deployment of a library assignment to a batch, with its own due date.
model AssignmentBatch {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  batchId      String
  batch        Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?      @relation("DeployedAssignments", fields: [assignedById], references: [id], onDelete: SetNull)
  dueDate      DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  students StudentAssignment[]

  @@unique([assignmentId, batchId])
  @@index([batchId])
  @@index([assignedById])
  @@map("assignment_batches")
}

model StudentAssignment {
  id                String           @id @default(cuid())
  assignmentBatchId String
  assignmentBatch   AssignmentBatch  @relation(fields: [assignmentBatchId], references: [id], onDelete: Cascade)
  studentId         String
  student           User             @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  status            AssignmentStatus @default(PENDING)
  completedAt       DateTime?        @map("completed_at")
  timeSpentSeconds  Int?             @map("time_spent_seconds")
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([assignmentBatchId, studentId])
  @@index([studentId])
  @@map("student_assignments")
}

//
// ACTIVITY & ANNOUNCEMENTS
//

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentActivity", fields: [studentId], references: [id], onDelete: Cascade)
  type      String // CLASS_JOINED, LESSON_COMPLETED, PRACTICE_FINISHED, FEEDBACK
  title     String
  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("student_activities")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String // BATCH, COURSE, PLATFORM
  createdAt   DateTime @default(now())

  @@map("announcements")
}

model RecordingWatchProgress {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  liveSessionId  String
  watchedSeconds Int      @default(0)
  updatedAt      DateTime @updatedAt

  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class       CoachClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@map("recording_watch_progress")
}
