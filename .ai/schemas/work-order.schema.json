{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexa AI Work Order",
  "type": "object",
  "required": ["task_id", "title", "objective", "priority", "type", "environment", "requirements", "acceptance_criteria", "required_tests", "safety"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^NEXA-\\d{4}$",
      "description": "Unique task identifier"
    },
    "title": {
      "type": "string",
      "description": "Short, descriptive title"
    },
    "objective": {
      "type": "string",
      "description": "What this task should accomplish"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "type": {
      "type": "string",
      "enum": ["feature_implementation", "bug_fix", "investigation", "refactor", "devops", "database", "research", "code_review", "testing", "documentation"]
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "medium", "complex"]
    },
    "problem_statement": {
      "type": "string",
      "description": "Precise formulation of the problem, bug, or feature request"
    },
    "attempt": {
      "type": "integer",
      "default": 1
    },
    "max_attempts": {
      "type": "integer",
      "default": 2
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "environment": {
      "type": "object",
      "properties": {
        "server": { "type": "string", "default": "nexa-vcn" },
        "environment": { "type": "string", "enum": ["development", "production"], "default": "development" },
        "project_path": { "type": "string", "default": "/opt/nexa-chess/NexaGen-dev" },
        "branch": { "type": "string", "description": "Task branch name (e.g., ai/NEXA-0001-desc)" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "relevant_files": { "type": "array", "items": { "type": "string" } },
        "related_models": { "type": "array", "items": { "type": "string" } },
        "affected_apps": { "type": "array", "items": { "type": "string" } },
        "affected_packages": { "type": "array", "items": { "type": "string" } },
        "architecture_notes": { "type": "string" }
      }
    },
    "affected_areas": {
      "type": "object",
      "properties": {
        "known": { "type": "array", "items": { "type": "string" } },
        "inferred": { "type": "array", "items": { "type": "string" } },
        "unknown": { "type": "array", "items": { "type": "string" } }
      }
    },
    "impact_analysis": {
      "type": "object",
      "properties": {
        "database_impact": { "type": "boolean" },
        "redis_impact": { "type": "boolean" },
        "livekit_impact": { "type": "boolean" },
        "api_impact": { "type": "boolean" },
        "frontend_impact": { "type": "boolean" }
      }
    },
    "instructions": {
      "type": "string",
      "description": "Explicit instructions for coding worker regarding inspection, reuse, and pattern adherence"
    },
    "investigation_instructions": {
      "type": "string",
      "description": "Step-by-step guidance for investigation and root cause analysis"
    },
    "implementation_guidance": {
      "type": "string",
      "description": "Implementation considerations, safety notes, and pattern reuse guidance"
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string", "enum": ["typecheck", "lint", "build", "unit_tests", "e2e_tests", "api_smoke_test"] }
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety": {
      "type": "object",
      "properties": {
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "blocked_paths": { "type": "array", "items": { "type": "string" } },
        "allowed_databases": { "type": "array", "items": { "type": "string" } },
        "blocked_databases": { "type": "array", "items": { "type": "string" } },
        "requires_approval": { "type": "boolean", "default": false }
      }
    },
    "state_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    },
    "assigned_worker": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "timeout_minutes": { "type": "integer", "default": 30 }
  }
}
