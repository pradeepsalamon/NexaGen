# .dockerignore patterns are anchored at the context root, so a bare
# `node_modules` only skipped the root one. `**/` is needed for the per-app
# build output and dependencies, which otherwise put ~3.5GB into every build
# context (apps/web/.next-build alone is ~1.8GB on the prod box).
**/node_modules
**/.next
**/.next-build
**/dist
**/.turbo
.env
.env.*
!.env.example
.git
*.log
# Egress recordings (root volume, mounted at runtime, never built in).
recordings
# Responsive screenshot output.
scripts/responsive/shots
