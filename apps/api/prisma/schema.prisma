generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COACH
  STUDENT
}

enum UserStatus {
  ACTIVE
  PENDING
  ARCHIVED
  DELETED
}

enum ReferralSource {
  ADS
  FRIEND
  SCHOOL
  OTHER
}

// Normalized acquisition channel captured at registration (User.acquisitionSource).
// UNKNOWN covers legacy rows and anyone who skipped the question — analytics never
// fabricates a source, it reports UNKNOWN.
enum AcquisitionSource {
  WEBSITE
  GOOGLE
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  WHATSAPP
  REFERRAL
  SCHOOL
  COACH_REFERRAL
  ADVERTISEMENT
  OTHER
  UNKNOWN
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CoachTitle {
  NONE
  CM
  FM
  IM
  GM
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  IN_PROGRESS
}

enum BatchScheduleStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum AttendanceStatus {
  PRESENT
  LATE
  PARTIAL
  ABSENT
}

enum AttendanceEventType {
  JOIN
  LEAVE
  DISCONNECT
  RECONNECT
  BOARD_JOIN
  BOARD_LEAVE
}

// Same value set as the pre-existing TS enum in
// apps/api/src/live-class/types/live-class.types.ts, which now re-exports
// this. Replaces LiveSession.status's untyped String (P0 reliability Phase 1).
enum LiveSessionStatus {
  SCHEDULED
  WAITING
  LIVE
  ENDED
  CANCELLED
}

enum AssignmentDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// The interactive activity an assignment asks the student to do. Existing rows
// predate this column and default to REPLAY (the legacy PGN-viewer behaviour).
enum AssignmentActivityType {
  REPLAY
  SOLVE_LINE
  PLAY_VS_ENGINE
  FREE_ANALYSIS
}

// Lifecycle of one StudentAssignmentAttempt.
enum AssignmentAttemptStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  ABANDONED
}

// Visibility of a reusable pre-class settings preset.
enum LiveClassPresetScope {
  PERSONAL // visible only to ownerId
  ORG // visible to every coach; managed by admins
}

// ── Puzzle library ──

// The kind of task a puzzle asks the solver to perform. Extensible; the solver
// treats every type the same (play the solution line) — the label is guidance.
enum PuzzleType {
  TACTICAL
  CHECKMATE
  BEST_MOVE
  CALCULATION
  ENDGAME
  OPENING
  CUSTOM
}

enum PuzzleDifficulty {
  BEGINNER
  EASY
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// Puzzle lifecycle. ARCHIVED is a reversible "retired" state (distinct from a
// soft delete, which routes through the Trash module).
enum PuzzleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// GLOBAL = admin-authored, available to every coach. PRIVATE = coach-authored,
// visible to the author + admins only. Coaches cannot create GLOBAL puzzles.
enum PuzzleVisibility {
  GLOBAL
  PRIVATE
}

// Lifecycle of one PuzzleAttempt by a student.
enum PuzzleAttemptStatus {
  IN_PROGRESS
  SOLVED
  FAILED
  ABANDONED
}

//
// USER
//

model User {
  id String @id @default(cuid())

  email    String  @unique
  username String? @unique
  password String

  firstName String
  lastName  String?

  phoneNumber String?

  avatarUrl String?

  role   UserRole   @default(STUDENT)
  status UserStatus @default(PENDING)

  timezone String @default("Asia/Kolkata")

  isEmailVerified Boolean @default(false)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  // Throttled recency signal (updated at most once / 10 min by ActivityTrackingInterceptor).
  // Null = never seen since the feature shipped; analytics treats it as "unknown", not inactive.
  lastActiveAt    DateTime?

  // ── Acquisition attribution (captured at registration; see analytics module) ──
  acquisitionSource AcquisitionSource @default(UNKNOWN)
  acquisitionDetail String? // free text for OTHER / referring coach name for COACH_REFERRAL
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  landingReferrer   String?

  createdById  String?
  createdBy    User?   @relation("UserCreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedUsers")

  studentProfile         StudentProfile?
  coachProfile           CoachProfile?            @relation("UserCoachProfile")
  approvedCoaches        CoachProfile[]           @relation("CoachApprovedBy")
  createdBatches         Batch[]                  @relation("BatchCreatedBy")
  coachedBatches         BatchCoach[]             @relation("BatchCoaches")
  studentBatches         BatchStudent[]           @relation("BatchStudents")
  classes                CoachClass[]             @relation("ClassCoach")
  authSessions           AuthSession[]
  passwordResets         PasswordResetToken[]
  emailVerifications     EmailVerificationToken[]
  deletedRecords         TrashAuditLog[]          @relation("TrashAuditDeletedBy")
  deletedStudentProfiles StudentProfile[]         @relation("StudentProfileDeletedBy")
  deletedCoachProfiles   CoachProfile[]           @relation("CoachProfileDeletedBy")
  deletedBatches         Batch[]                  @relation("BatchDeletedBy")
  deletedBatchCoaches    BatchCoach[]             @relation("BatchCoachDeletedBy")
  deletedBatchStudents   BatchStudent[]           @relation("BatchStudentDeletedBy")
  liveSessions           LiveSession[]            @relation("LiveClassCoach")
  courseProgress         StudentCourseProgress[]  @relation("StudentCourseProgress")
  practices              StudentPractice[]        @relation("StudentPractice")
  authoredAssignments    Assignment[]             @relation("AuthoredAssignments")
  deployedAssignments    AssignmentBatch[]        @relation("DeployedAssignments")
  studentAssignments     StudentAssignment[]      @relation("StudentAssignments")
  createdPuzzleTopics    PuzzleTopic[]            @relation("PuzzleTopicCreatedBy")
  deletedPuzzleTopics    PuzzleTopic[]            @relation("PuzzleTopicDeletedBy")
  authoredPuzzles        Puzzle[]                 @relation("AuthoredPuzzles")
  deletedPuzzles         Puzzle[]                 @relation("PuzzleDeletedBy")
  studentPuzzleAttempts  PuzzleAttempt[]          @relation("StudentPuzzleAttempts")
  activities             StudentActivity[]        @relation("StudentActivity")
  classAttendances       ClassAttendance[]
  attendanceLogs         AttendanceLog[]          @relation("UserAttendanceLogs")
  coachAttendances       CoachAttendance[]        @relation("CoachClassAttendance")
  coachAttendanceLogs    CoachAttendanceLog[]     @relation("UserCoachAttendanceLogs")
  chatMessages           LiveChatMessage[]        @relation("UserLiveChatMessages")
  directChatMessages     LiveChatMessage[]        @relation("UserLiveChatDirectMessages")
  notifications          Notification[]           @relation("UserNotifications")
  createdBatchSchedules  BatchClassSchedule[]     @relation("BatchScheduleCreatedBy")
  scheduleRules          BatchClassScheduleRule[] @relation("BatchScheduleRuleCoach")
  analyticsEvents        AnalyticsEvent[]         @relation("UserAnalyticsEvents")
  liveClassPresets       LiveClassPreset[]        @relation("UserLiveClassPresets")

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  isDeleted                Boolean                  @default(false)
  deletedAt                DateTime?
  deletedById              String?
  deletedBy                User?                    @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedUsers             User[]                   @relation("UserDeletedBy")
  deleteGroupId            String?
  recordingWatchProgresses RecordingWatchProgress[]

  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([acquisitionSource])
  @@map("users")
}

//
// STUDENT PROFILE
//

model StudentProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth DateTime?

  chessRating Int?
  fideId      String?

  experienceLevel ExperienceLevel @default(BEGINNER)
  referralSource  ReferralSource  @default(OTHER)

  parentName  String
  parentEmail String?
  parentPhone String?

  parentRelationship String?

  enrolledAt DateTime @default(now())

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("StudentProfileDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("student_profiles")
}

//
// COACH PROFILE
//

model CoachProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("UserCoachProfile", fields: [userId], references: [id], onDelete: Cascade)

  title CoachTitle @default(NONE)

  bio String?

  qualification String?

  fideId     String?
  fideRating Int?

  specialization String?

  yearsOfExperience Int?

  hourlyRate Decimal? @db.Decimal(10, 2)

  approvalStatus UserStatus @default(PENDING)

  approvedById String?
  approvedBy   User?   @relation("CoachApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("CoachProfileDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("coach_profiles")
}

//
// AUTH SESSION
//

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

//
// BATCHES
//

model Batch {
  id String @id @default(cuid())

  name          String
  description   String?
  scheduleNotes String?

  status BatchStatus @default(ACTIVE)

  startsAt DateTime? @db.Date
  endsAt   DateTime? @db.Date

  // Layer 3 pre-class defaults (partial LiveClassSettingsOverride blob; null =
  // inherit system defaults). Validated by the shared Zod schema in
  // `@nexa-chess/types`, never queried by key.
  liveClassSettings Json?

  createdById String?
  createdBy   User?   @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  coaches      BatchCoach[]
  students     BatchStudent[]
  classes      CoachClass[]
  liveSessions LiveSession[]
  assignments  AssignmentBatch[]
  schedules    BatchClassSchedule[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("BatchDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([status])
  @@index([createdById])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("batches")
}

model BatchCoach {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("BatchCoaches", fields: [coachId], references: [id], onDelete: Cascade)

  assignedAt    DateTime  @default(now())
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("BatchCoachDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@unique([batchId, coachId])
  @@index([coachId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("batch_coaches")
}

model BatchStudent {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("BatchStudents", fields: [studentId], references: [id], onDelete: Cascade)

  enrolledAt    DateTime  @default(now())
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("BatchStudentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("batch_students")
}

model TrashAuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  user      User?    @relation("TrashAuditDeletedBy", fields: [userId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("trash_audit_logs")
}

//
// CLASSES
//

model CoachClass {
  id String @id @default(cuid())

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("ClassCoach", fields: [coachId], references: [id], onDelete: Cascade)

  isDemo Boolean @default(false)

  title       String?
  topic       String?
  description String?
  objectives  String?
  homework    String?
  notes       String?

  status ClassStatus @default(SCHEDULED)

  startsAt DateTime
  endsAt   DateTime

  meetingRoomId String?

  // Layer 2 pre-class config (partial LiveClassSettingsOverride blob; null =
  // inherit batch/system). Resolved + frozen onto LiveSession at class start.
  liveClassSettings Json?

  // ── Recurring-schedule linkage (all nullable; manual classes leave them null) ──
  scheduleId     String?
  schedule       BatchClassSchedule?     @relation("BatchScheduleClasses", fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleRuleId String?
  scheduleRule   BatchClassScheduleRule? @relation("BatchScheduleRuleClasses", fields: [scheduleRuleId], references: [id], onDelete: SetNull)
  // Local calendar day of the occurrence in the schedule's timezone.
  occurrenceDate DateTime?               @db.Date
  // Chronological class number within the owning schedule (stable once assigned).
  sessionNumber  Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  liveSession              LiveSession?             @relation("LiveSessionSchedule")
  attendances              ClassAttendance[]
  coachAttendance          CoachAttendance?
  recordingWatchProgresses RecordingWatchProgress[]

  @@unique([scheduleId, occurrenceDate, scheduleRuleId], map: "classes_schedule_occurrence_unique")
  @@index([batchId])
  @@index([coachId])
  @@index([status])
  @@index([startsAt])
  @@index([isDemo])
  @@index([scheduleId])
  @@index([batchId, startsAt])
  @@map("classes")
}

//
// BATCH RECURRING CLASS SCHEDULES
//

/// The recurrence template for a batch's weekly classes. Generating it produces
/// real `CoachClass` rows (one per occurrence) that behave exactly like
/// manually-created classes for live-class, attendance, assignments, etc.
model BatchClassSchedule {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  title    String
  /// IANA timezone the wall-clock rule times are interpreted in.
  timezone String @default("Asia/Kolkata")

  /// Local calendar days (inclusive) the recurrence spans.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  status BatchScheduleStatus @default(ACTIVE)

  createdById String?
  createdBy   User?   @relation("BatchScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  rules      BatchClassScheduleRule[]
  exceptions BatchScheduleException[]
  classes    CoachClass[]             @relation("BatchScheduleClasses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([status])
  @@map("batch_class_schedules")
}

/// One weekly slot in a schedule: "every <dayOfWeek> from <startTime> to
/// <endTime> with <coach>".
model BatchClassScheduleRule {
  id String @id @default(cuid())

  scheduleId String
  schedule   BatchClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday (JS getUTCDay convention).
  dayOfWeek Int
  /// "HH:MM" 24h wall-clock in the schedule's timezone.
  startTime String
  endTime   String

  coachId String
  coach   User   @relation("BatchScheduleRuleCoach", fields: [coachId], references: [id], onDelete: Cascade)

  isEnabled Boolean @default(true)

  classes CoachClass[] @relation("BatchScheduleRuleClasses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
  @@index([coachId])
  @@map("batch_class_schedule_rules")
}

/// A single local date excluded from a schedule (holiday / batch break). The
/// recurrence rule stays intact; only generation skips the date.
model BatchScheduleException {
  id String @id @default(cuid())

  scheduleId String
  schedule   BatchClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  date   DateTime @db.Date
  reason String?

  createdAt DateTime @default(now())

  @@unique([scheduleId, date])
  @@index([scheduleId])
  @@map("batch_schedule_exceptions")
}

model ClassAttendance {
  id String @id @default(cuid())

  classId String
  class   CoachClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status   AttendanceStatus @default(PRESENT)
  joinedAt DateTime?        @default(now())
  leftAt   DateTime?

  totalDuration     Int? // Total seconds actually in class
  attendancePercent Float? // 0-100 calculated percentage
  reconnectCount    Int       @default(0)
  lastActivity      DateTime?
  // Last heartbeat ping from the client (POST /live-class/:id/heartbeat),
  // fallback presence signal when a LiveKit webhook is lost. Null until the
  // client starts sending heartbeats; the timeout sweep only ever acts on
  // non-null values (P0 reliability Phase 1).
  lastHeartbeatAt   DateTime?

  logs AttendanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@map("class_attendance")
}

model AttendanceLog {
  id String @id @default(cuid())

  attendanceId String
  attendance   ClassAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserAttendanceLogs", fields: [userId], references: [id], onDelete: Cascade)

  eventType AttendanceEventType
  timestamp DateTime            @default(now())

  sessionStart    DateTime?
  sessionEnd      DateTime?
  sessionDuration Int? // seconds for this segment

  reason    String? // disconnect reason from LiveKit
  userAgent String?
  ipAddress String?
  source    String  @default("LIVEKIT") // LIVEKIT, MANUAL, SYSTEM

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
  // Serves the "find the still-open session" lookup on every join/leave webhook.
  @@index([attendanceId, eventType, sessionEnd], map: "attendance_logs_open_session_idx")
  @@map("attendance_logs")
}

model CoachAttendance {
  id String @id @default(cuid())

  classId String     @unique
  class   CoachClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("CoachClassAttendance", fields: [coachId], references: [id], onDelete: Cascade)

  status   AttendanceStatus @default(PRESENT)
  joinedAt DateTime?        @default(now())
  leftAt   DateTime?

  totalDuration   Int? // Total seconds coach was in class
  boardDuration   Int? // Total seconds board was active in this class
  reconnectCount  Int       @default(0)
  lastActivity    DateTime?
  // See ClassAttendance.lastHeartbeatAt.
  lastHeartbeatAt DateTime?

  logs CoachAttendanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId])
  @@index([status])
  @@map("coach_attendance")
}

model CoachAttendanceLog {
  id String @id @default(cuid())

  attendanceId String
  attendance   CoachAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserCoachAttendanceLogs", fields: [userId], references: [id], onDelete: Cascade)

  eventType AttendanceEventType
  timestamp DateTime            @default(now())

  sessionStart    DateTime?
  sessionEnd      DateTime?
  sessionDuration Int? // seconds for this segment

  reason    String? // disconnect reason
  userAgent String?
  ipAddress String?
  source    String  @default("LIVEKIT") // LIVEKIT, MANUAL, SYSTEM

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
  @@map("coach_attendance_logs")
}

model AttendancePolicy {
  id String @id @default(cuid())

  name     String  @default("Default Policy")
  isActive Boolean @default(true)

  presentThreshold Float @default(90)
  lateThreshold    Float @default(70)
  partialThreshold Float @default(30)

  gracePeriodMinutes Int @default(5)
  minDurationMinutes Int @default(5)
  reconnectTolerance Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendance_policies")
}

//
// LIVE CLASSES
//

model LiveSession {
  id String @id @default(cuid())

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("LiveClassCoach", fields: [coachId], references: [id], onDelete: Cascade)

  classId String     @unique
  class   CoachClass @relation("LiveSessionSchedule", fields: [classId], references: [id], onDelete: Cascade)

  roomName        String  @unique
  livekitRoomName String? @unique

  status LiveSessionStatus @default(SCHEDULED)

  scheduledAt  DateTime
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?

  // ── Recording metadata (promoted out of `metadata` JSON for analytics) ──
  recordingBytes           BigInt? // file size in bytes; null = unknown / file pruned
  recordingDurationSeconds Int?
  recordingStatus          String? // RECORDING | STOPPING | COMPLETED | FAILED | PURGED_STORAGE_LIMIT
  recordingStartedAt       DateTime?
  recordingCompletedAt     DateTime?

  attendanceFinalizedAt DateTime?

  // Frozen fully-resolved LiveClassSettings captured at class start (§38). Null
  // for sessions started before this feature — token grants fall back to the
  // pre-feature logic for those.
  effectiveSettings  Json?
  settingsSnapshotAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metadata Json?

  chatMessages             LiveChatMessage[]
  recordingWatchProgresses RecordingWatchProgress[]

  @@index([batchId])
  @@index([coachId])
  @@index([status])
  @@index([startedAt])
  @@index([endedAt])
  @@map("live_sessions")
}

model LiveChatMessage {
  id String @id @default(cuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("UserLiveChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  senderName String
  senderRole String?

  /// One-to-one private message when set; null is a room-wide message. The
  /// student <-> student case is rejected by the API, never merely hidden.
  recipientId String?
  recipient   User?   @relation("UserLiveChatDirectMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  message String @db.Text

  /// LiveKit's message id, so history reconciliation dedupes on identity
  /// instead of senderName+text+timestamp — which dropped a legitimately
  /// repeated short message (AUDIT M24).
  clientMessageId String?

  createdAt DateTime @default(now())

  @@index([liveSessionId])
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@index([clientMessageId])
  @@map("live_chat_messages")
}

/// Dedupe key for LiveKit webhook deliveries. LiveKit retries webhooks, and
/// without this a retried `participant_joined` / `participant_left` produced
/// duplicate RECONNECT logs and inflated durations (AUDIT M1).
model ProcessedWebhookEvent {
  id          String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("processed_webhook_events")
}

//
// PRE-CLASS SETTINGS (Layer 1 defaults + Layer 4 presets)
//

/// Singleton row holding the global default LiveClassSettings blob (Layer 1).
/// Mirrors AttendancePolicy: lazily created, admin-managed. `isActive` selects
/// the live row if more than one ever exists.
model LiveClassPolicy {
  id       String  @id @default(cuid())
  name     String  @default("Default Live Class Policy")
  isActive Boolean @default(true)

  /// Full LiveClassSettings JSON (validated by @nexa-chess/types).
  settings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("live_class_policies")
}

/// A reusable pre-class configuration a coach (PERSONAL) or admin (ORG) can
/// apply while creating/editing a class. Applying copies `settings` into the
/// class — never a live reference (§23). Not soft-deletable (like Assignment).
model LiveClassPreset {
  id String @id @default(cuid())

  ownerId String?
  owner   User?   @relation("UserLiveClassPresets", fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?

  scope     LiveClassPresetScope @default(PERSONAL)
  isSystem  Boolean              @default(false)
  isDefault Boolean              @default(false)

  /// Partial LiveClassSettingsOverride JSON (validated by @nexa-chess/types).
  settings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([scope])
  @@map("live_class_presets")
}

//
// COURSES
//

model Course {
  id          String                  @id @default(cuid())
  title       String
  description String?
  modules     CourseModule[]
  progress    StudentCourseProgress[]
  schedules   BatchClassSchedule[]
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
}

model StudentCourseProgress {
  id              String   @id @default(cuid())
  studentId       String
  student         User     @relation("StudentCourseProgress", fields: [studentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercent Int      @default(0)
  lastOpenedAt    DateTime @default(now())

  @@unique([studentId, courseId])
  @@map("student_course_progress")
}

//
// PRACTICE & ASSIGNMENTS
//

model Practice {
  id         String            @id @default(cuid())
  title      String
  difficulty String // BEGINNER, INTERMEDIATE, ADVANCED
  dueDate    DateTime
  students   StudentPractice[]
}

model StudentPractice {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation("StudentPractice", fields: [studentId], references: [id], onDelete: Cascade)
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  status     String // PENDING, IN_PROGRESS, COMPLETED

  @@unique([studentId, practiceId])
  @@map("student_practices")
}

// A reusable PGN assignment in the library. Admins author shared items
// (`isLibrary = true`, visible to every coach); coaches author private items
// (`isLibrary = false`, visible only to the author). Not soft-deletable — a
// delete cascades to every deployment + per-student row.
model Assignment {
  id               String               @id @default(cuid())
  createdById      String?
  createdBy        User?                @relation("AuthoredAssignments", fields: [createdById], references: [id], onDelete: SetNull)
  isLibrary        Boolean              @default(false)
  title            String
  description      String?
  pgn              String // raw PGN text (source of truth for the REPLAY board viewer)
  pgnUrl           String? // Cloudinary raw-file URL for download
  difficulty       AssignmentDifficulty @default(BEGINNER)
  timeLimitMinutes Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // ── Interactive-activity configuration (all additive; REPLAY ignores them) ──
  activityType              AssignmentActivityType @default(REPLAY)
  startFen                  String? // starting position for SOLVE_LINE / PLAY_VS_ENGINE / FREE_ANALYSIS
  solutionMovesJson         Json? // [{ uci, san }] — expected line for SOLVE_LINE (never sent to students pre-completion)
  orientation               String? // "white" | "black" — board orientation for the student
  studentColor              String? // "white" | "black" — side the student plays (SOLVE_LINE / PLAY_VS_ENGINE)
  engineLevel               Int? // Stockfish skill level 0-20 for PLAY_VS_ENGINE
  passThresholdPercent      Int                    @default(100)
  maxAttempts               Int? // null = unlimited
  allowHints                Boolean                @default(false)
  allowRetry                Boolean                @default(true)
  requiredCompletionPercent Int                    @default(100)

  deployments AssignmentBatch[]

  @@index([createdById])
  @@index([isLibrary])
  @@map("assignments")
}

// One deployment of a library assignment to a batch, with its own due date.
model AssignmentBatch {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  batchId      String
  batch        Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?      @relation("DeployedAssignments", fields: [assignedById], references: [id], onDelete: SetNull)
  dueDate      DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  students StudentAssignment[]

  @@unique([assignmentId, batchId])
  @@index([batchId])
  @@index([assignedById])
  @@map("assignment_batches")
}

model StudentAssignment {
  id                String           @id @default(cuid())
  assignmentBatchId String
  assignmentBatch   AssignmentBatch  @relation(fields: [assignmentBatchId], references: [id], onDelete: Cascade)
  studentId         String
  student           User             @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  status            AssignmentStatus @default(PENDING)
  completedAt       DateTime?        @map("completed_at")
  timeSpentSeconds  Int?             @map("time_spent_seconds")
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // ── Evaluated-activity progress (null for legacy REPLAY rows) ──
  bestScorePercent    Int?
  bestAccuracyPercent Int?
  attemptCount        Int       @default(0)
  lastAttemptAt       DateTime?

  attempts StudentAssignmentAttempt[]

  @@unique([assignmentBatchId, studentId])
  @@index([studentId])
  @@index([completedAt])
  @@map("student_assignments")
}

// One execution of an evaluated assignment by a student. Progress is saved
// incrementally (movesJson); the server evaluates authoritatively on submit.
model StudentAssignmentAttempt {
  id                  String                  @id @default(cuid())
  studentAssignmentId String
  studentAssignment   StudentAssignment       @relation(fields: [studentAssignmentId], references: [id], onDelete: Cascade)
  attemptNumber       Int
  status              AssignmentAttemptStatus @default(IN_PROGRESS)
  movesJson           Json                    @default("[]") // [{ ply, uci, san, fenAfter, correct?, classification?, elapsedMs? }]
  scorePercent        Int?
  accuracyPercent     Int?
  hintsUsed           Int                     @default(0)
  durationSeconds     Int                     @default(0)
  result              String? // "SOLVED" | "PARTIAL" | "WIN" | "LOSS" | "DRAW" | "SUBMITTED"
  startedAt           DateTime                @default(now())
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([studentAssignmentId, attemptNumber])
  @@index([studentAssignmentId])
  @@map("student_assignment_attempts")
}

//
// NOTIFICATIONS
//

enum NotificationType {
  ASSIGNMENT_DUE_SOON
  ASSIGNMENT_GRADED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  /// in-app deep link, e.g. /student/assignments/<id>
  linkPath  String?
  /// idempotency key so schedulers never double-send (null = always insert)
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

//
// ACTIVITY & ANNOUNCEMENTS
//

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentActivity", fields: [studentId], references: [id], onDelete: Cascade)
  type      String // CLASS_JOINED, LESSON_COMPLETED, PRACTICE_FINISHED, FEEDBACK
  title     String
  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("student_activities")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String // BATCH, COURSE, PLATFORM
  createdAt   DateTime @default(now())

  @@map("announcements")
}

model RecordingWatchProgress {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  liveSessionId  String
  watchedSeconds Int      @default(0)
  updatedAt      DateTime @updatedAt

  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class       CoachClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@map("recording_watch_progress")
}

//
// ANALYTICS
//

/// One meaningful product action by a user. Powers DAU/WAU/MAU, new-vs-returning,
/// and the engagement section. Written fire-and-forget by AnalyticsEventService —
/// a failed insert never breaks the originating request.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserAnalyticsEvents", fields: [userId], references: [id], onDelete: Cascade)
  type       String // LOGIN | CLASS_JOIN | ASSIGNMENT_ATTEMPT | RECORDING_WATCH | DASHBOARD_VIEW
  entityId   String? // class id / assignment id / etc.
  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@index([occurredAt])
  @@map("analytics_events")
}

/// Daily rollup of recording-storage usage. One row per business-timezone day,
/// written by AnalyticsScheduler. Drives the storage growth chart and forecast.
model StorageSnapshot {
  id             String   @id @default(cuid())
  capturedAt     DateTime @default(now())
  capturedDate   DateTime @unique @db.Date
  recordingBytes BigInt
  recordingCount Int
  limitBytes     BigInt

  @@index([capturedAt])
  @@map("storage_snapshots")
}

//
// PUZZLE LIBRARY
//

// A chess-training theme (Fork, Pin, Back Rank, Checkmate in 2, …). Admin-only
// authoring; every puzzle belongs to exactly one topic. Soft-deletable — the
// `name`/`slug` unique indexes are partial (`WHERE "isDeleted" = false`), added
// by hand in the migration so a deleted topic's name can be reused.
model PuzzleTopic {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  icon        String? // lucide icon name or emoji
  sortOrder   Int     @default(0)

  createdById String?
  createdBy   User?   @relation("PuzzleTopicCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  puzzles Puzzle[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("PuzzleTopicDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@index([sortOrder])
  @@map("puzzle_topics")
}

// A reusable chess-training object: position + solution line + topic + type +
// difficulty + ownership + lifecycle. GLOBAL puzzles are admin-authored and
// visible to every coach; PRIVATE puzzles are coach-authored and visible only to
// the author + admins. The same puzzle will later be referenced by a
// LiveClassPuzzleAssignment without being copied.
model Puzzle {
  id          String      @id @default(cuid())
  topicId     String
  topic       PuzzleTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  title       String
  description String?

  puzzleType PuzzleType
  difficulty PuzzleDifficulty

  fen               String // starting position (the position the solver sees)
  solutionMovesJson Json     @default("[]") // [{ uci, san }] — the expected line
  explanation       String?
  hintsJson         Json? // string[] — progressive text hints
  tags              String[] @default([])
  estimatedSeconds  Int?

  status     PuzzleStatus     @default(DRAFT)
  visibility PuzzleVisibility @default(PRIVATE)

  createdById   String?
  createdBy     User?     @relation("AuthoredPuzzles", fields: [createdById], references: [id], onDelete: SetNull)
  createdByRole UserRole // snapshot so the "Admin" vs coach label survives author deletion
  updatedById   String?
  publishedById String?
  publishedAt   DateTime?
  archivedById  String?
  archivedAt    DateTime?

  attempts PuzzleAttempt[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("PuzzleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([topicId])
  @@index([createdById])
  @@index([puzzleType])
  @@index([difficulty])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("puzzles")
}

// One solve attempt by a student. Progress is saved incrementally (movesJson);
// the server evaluates authoritatively on submit. `liveClassId` is an
// unconstrained nullable column reserved for the future LiveClassPuzzleAssignment
// feature — no FK yet.
model PuzzleAttempt {
  id        String @id @default(cuid())
  puzzleId  String
  puzzle    Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation("StudentPuzzleAttempts", fields: [studentId], references: [id], onDelete: Cascade)

  liveClassId String?

  attemptNumber   Int
  status          PuzzleAttemptStatus @default(IN_PROGRESS)
  movesJson       Json                @default("[]") // [{ ply, uci, san, fenAfter, correct?, … }]
  scorePercent    Int?
  accuracyPercent Int?
  hintsUsed       Int                 @default(0)
  durationSeconds Int                 @default(0)
  result          String? // "SOLVED" | "FAILED"
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([puzzleId, studentId, attemptNumber])
  @@index([puzzleId])
  @@index([studentId])
  @@index([liveClassId])
  @@map("puzzle_attempts")
}
