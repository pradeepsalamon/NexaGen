{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexa AI Work Order",
  "type": "object",
  "required": ["task_id", "title", "objective", "priority", "type", "environment", "requirements", "acceptance_criteria", "required_tests", "safety"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^NEXA-\\d{4}$",
      "description": "Unique task identifier"
    },
    "title": {
      "type": "string",
      "description": "Short, descriptive title"
    },
    "objective": {
      "type": "string",
      "description": "What this task should accomplish"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "type": {
      "type": "string",
      "enum": ["feature_implementation", "bug_fix", "refactor", "devops", "database", "research", "code_review", "testing", "documentation"]
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "medium", "complex"]
    },
    "environment": {
      "type": "object",
      "properties": {
        "server": { "type": "string", "default": "nexa-vcn" },
        "environment": { "type": "string", "enum": ["development", "production"], "default": "development" },
        "project_path": { "type": "string", "default": "/opt/nexa-chess/NexaGen-dev" },
        "branch": { "type": "string", "description": "Task branch name (e.g., ai/NEXA-0001-desc)" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "relevant_files": { "type": "array", "items": { "type": "string" } },
        "related_models": { "type": "array", "items": { "type": "string" } },
        "architecture_notes": { "type": "string" }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string", "enum": ["typecheck", "lint", "build", "unit_tests", "e2e_tests", "api_smoke_test"] }
    },
    "safety": {
      "type": "object",
      "properties": {
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "blocked_paths": { "type": "array", "items": { "type": "string" } },
        "allowed_databases": { "type": "array", "items": { "type": "string" } },
        "blocked_databases": { "type": "array", "items": { "type": "string" } },
        "requires_approval": { "type": "boolean", "default": false }
      }
    },
    "assigned_worker": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "timeout_minutes": { "type": "integer", "default": 30 }
  }
}
