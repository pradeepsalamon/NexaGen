// Platform default points + leaderboard rules for live-class puzzles
// (singleton, id "default"). Seeded lazily on first read — no seed migration.
// Cosmetic-level config: not soft-deletable, not Trash-registered.
model PuzzleScoringSettings {
  id              String   @id @default("default")
  /// PuzzleScoring JSON (validated by @nexa-chess/types).
  scoringJson     Json?
  /// PuzzleLeaderboardOptions JSON.
  leaderboardJson Json?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("puzzle_scoring_settings")
}

//
// ADMIN MESSAGING
//
// One rule per event decides whether a message goes out, on which channels, to
// whom, and what it says. The shared catalogue, templates and renderer live in
// `@nexa-chess/types` (messaging.ts) so the admin UI previews the exact string
// the dispatcher builds.

enum MessagingEvent {
  INVOICE_ISSUED
  CLASS_SCHEDULED
  CLASS_REMINDER
  CLASS_REMINDER_COACH
  CLASS_CANCELLED
  ASSIGNMENT_ASSIGNED
  ASSIGNMENT_DUE_SOON
  ASSIGNMENT_GRADED
  ANNOUNCEMENT
  ACCOUNT_WELCOME
  ACCOUNT_APPROVED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  REFUND_PROCESSED
  SUBSCRIPTION_RENEWAL_FAILED
  PAYROLL_FINALIZED
  PAYROLL_PAID
}

enum MessagingScheduleMode {
  IMMEDIATE
  DAILY
  WEEKLY
}

enum MessagingAudience {
  STUDENTS
  COACHES
  STUDENTS_AND_COACHES
}

enum MessageChannel {
  WHATSAPP
  IN_APP
}

enum MessageDeliveryStatus {
  /// Queued in the outbox; MessagingDeliveryWorker sends it on the next sweep.
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AnnouncementAudience {
  EVERYONE
  STUDENTS
  COACHES
  BATCH
}

/// Admin-editable rule for one event. Seeded from DEFAULT_MESSAGING_RULES the
/// first time the rules are read; every rule ships disabled.
model MessagingRule {
  id String @id @default(cuid())

  event MessagingEvent @unique

  enabled         Boolean @default(false)
  whatsappEnabled Boolean @default(true)
  inAppEnabled    Boolean @default(true)

  audience          MessagingAudience     @default(STUDENTS)
  /// Minutes before the moment, for lead-time events (class reminder, due soon).
  leadTimeMinutes   Int?
  /// When queued messages become due. Read in the RECIPIENT's timezone, so a
  /// 9am daily rule reaches everyone at their own 9am. Lead-time events ignore it.
  scheduleMode      MessagingScheduleMode @default(IMMEDIATE)
  scheduleHour      Int?
  scheduleMinute    Int?
  /// 0 = Sunday .. 6 = Saturday. WEEKLY only.
  scheduleDayOfWeek Int?
  /// DAILY only: a weekend send rolls forward to Monday.
  weekdaysOnly      Boolean               @default(false)

  /// In-app heading. WhatsApp has no subject line and ignores it.
  title String
  body  String

  /// Approved WhatsApp template, for sends that may fall outside the 24h window.
  whatsappTemplateName     String?
  whatsappTemplateLanguage String?
  whatsappTemplateParams   String[]

  updatedById String?
  updatedBy   User?   @relation("MessagingRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messaging_rules")
}

/// One attempted message. Written before the provider call, so a dropped queue
/// job or a provider outage still leaves an admin-visible record.
model MessageDelivery {
  id String @id @default(cuid())

  event   MessagingEvent
  channel MessageChannel
  status  MessageDeliveryStatus

  recipientId    String?
  recipient      User?   @relation("UserMessageDeliveries", fields: [recipientId], references: [id], onDelete: SetNull)
  /// E.164 digits actually dialled. Masked to the last 4 before it leaves the API.
  recipientPhone String?
  /// Rendered at queue time: what the rule said then, not what it says now.
  body           String
  title          String?
  linkPath       String?

  /// Rendered WhatsApp template, when the rule names one instead of free text.
  templateName     String?
  templateLanguage String?
  templateParams   String[]

  /// An attachment resolved at queue time, so the worker never has to reach
  /// back into a feature module to build one. `documentMediaId` is an upload
  /// Meta already holds — preferred over a link, because a financial document
  /// should not need a fetchable URL and a signed one could expire before the
  /// outbox gets to it.
  documentMediaId  String?
  documentLink     String?
  documentFilename String?

  /// When the outbox may send it. Future for a DAILY/WEEKLY rule or a backoff.
  scheduledFor  DateTime  @default(now())
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  /// Set while a worker holds the row; stale claims are reaped after 5 minutes.
  claimedAt     DateTime?
  sentAt        DateTime?

  /// Provider handle ("wamid.…") for a delivered WhatsApp message.
  providerMessageId String?
  error             String?

  /// Idempotency key so a scheduler never double-sends. Null = always insert.
  dedupeKey String?

  createdAt DateTime @default(now())

  @@unique([channel, dedupeKey])
  @@index([status, scheduledFor])
  @@index([event, createdAt])
  @@index([status])
  @@index([recipientId])
  @@index([createdAt])
  @@map("message_deliveries")
}

//
// PAYMENTS
//
// Provider-agnostic. Business logic only ever talks to PaymentService; the
// PaymentRouter decides which of Razorpay / Cashfree / Stripe handles an
// attempt. Money is ALWAYS stored as integer minor units (paise, cents) — never
// a float and never a Decimal a rounding bug can shave.
//
// Nothing here is soft-deletable. A financial record is never trashed, so these
// models are deliberately absent from softDeleteModels and the Trash module;
// lifecycle is expressed with status columns instead.
//

enum PaymentProvider {
  RAZORPAY
  CASHFREE
  STRIPE
  /// Cash / personal UPI-GPay / bank transfer — recorded by an admin or coach for
  /// tracking, never routed to by PaymentRouterService or given a provider adapter.
  MANUAL
}

/// Approval workflow for a coach-submitted manual payment. An admin's own record is
/// created straight into APPROVED.
enum OfflinePaymentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Unified payment state. Every provider status maps into this (see
/// providers/*.mapper.ts); nothing outside that folder knows a provider string.
enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrderStatus {
  CREATED
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  EXPIRED
  FAILED
}

enum PaymentMethodKind {
  UPI
  CARD
  NET_BANKING
  WALLET
  EMI
  PAY_LATER
  APPLE_PAY
  GOOGLE_PAY
  OTHER
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BillingInterval {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  CREATED
  PENDING_ACTIVATION
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_REFUNDED
  VOID
  REFUNDED
}

/// The PDF artifact's own state, separate from the financial status above: a
/// render that fails must never make a paid invoice look unpaid (section 20).
enum InvoicePdfStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

/// How a sale is taxed. Resolved from the seller's and buyer's place of
/// supply, never assumed.
enum TaxTreatment {
  NONE
  INTRA_STATE
  INTER_STATE
  EXPORT
  REVERSE_CHARGE
}

enum CreditNoteReason {
  REFUND
  CANCELLATION
  CORRECTION
  WRITE_OFF
  OTHER
}

enum InvoiceEventType {
  PAYMENT_CONFIRMED
  INVOICE_GENERATION_REQUESTED
  INVOICE_GENERATED
  INVOICE_GENERATION_FAILED
  INVOICE_EMAIL_REQUESTED
  INVOICE_EMAIL_SENT
  INVOICE_EMAIL_FAILED
  INVOICE_DOWNLOADED
  INVOICE_VIEWED
  REFUND_COMPLETED
  CREDIT_NOTE_CREATED
  INVOICE_SETTINGS_UPDATED
}

/// What a paid order actually unlocks. The gateway is NOT the source of truth
/// for access (§21) — this row is.
enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PaymentProviderEventKind {
  API_CALL
  WEBHOOK
}

/// A sellable product. `batchId` is what a successful purchase enrols into.
model Plan {
  id String @id @default(cuid())

  code        String  @unique
  name        String
  description String?

  /// Minor units (99900 = ₹999.00).
  amount   Int
  currency String @default("INR")

  interval BillingInterval @default(ONE_TIME)

  /// Access length per purchase, in days. Null = the billing interval.
  accessDays Int?

  /// GST / VAT percent added on top of `amount`.
  taxPercent Float @default(0)

  batchId String?
  batch   Batch?  @relation("PlanBatch", fields: [batchId], references: [id], onDelete: SetNull)

  features String[]

  /// Methods this plan accepts. Empty = whatever the gateways can serve. Always
  /// intersected with the platform-wide switches, so it narrows, never widens.
  allowedMethods PaymentMethodKind[]

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// Provider-side plan/price handles, keyed by provider ("STRIPE": "price_…").
  /// Created lazily on first recurring checkout and cached here.
  providerPlanIds Json?

  orders        Order[]
  subscriptions Subscription[]
  entitlements  Entitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([batchId])
  @@map("plans")
}

/// The business order. One order may carry several payment attempts (§12) but
/// only ever grants its entitlement once.
model Order {
  id String @id @default(cuid())

  /// Human handle shown to the user and to support. NEXA-2026-000123.
  orderNumber String @unique

  userId String
  user   User   @relation("UserOrders", fields: [userId], references: [id], onDelete: Restrict)

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  status OrderStatus @default(CREATED)

  /// Minor units. subtotalAmount + taxAmount - discountAmount = amount.
  subtotalAmount Int
  taxAmount      Int    @default(0)
  discountAmount Int    @default(0)
  amount         Int
  currency       String @default("INR")

  /// Client-supplied checkout key. The unique index IS the double-submit guard:
  /// a second click / refresh / tab replays the same key and collides instead
  /// of opening a second order.
  idempotencyKey String @unique

  discountId         String?
  discount           Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  /// Copied at order time, so a later rename or deletion never rewrites what
  /// the customer was told they used.
  discountCode       String?
  discountRedemption DiscountRedemption?

  notes Json?

  paidAt    DateTime?
  expiresAt DateTime?

  payments     Payment[]
  attempts     PaymentAttempt[]
  invoice      Invoice?
  entitlements Entitlement[]
  subscription Subscription?    @relation("SubscriptionInitialOrder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([planId])
  @@index([createdAt])
  @@index([discountId])
  @@map("orders")
}

/// One payment as the provider sees it. Created before the gateway is called,
/// so a network timeout still leaves a reconcilable record.
model Payment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation("UserPayments", fields: [userId], references: [id], onDelete: SetNull)

  provider PaymentProvider

  /// The gateway's own handles. (provider, providerPaymentId) is unique, which
  /// is what stops a replayed webhook creating a second payment.
  providerPaymentId String?
  providerOrderId   String?

  /// Minor units.
  amount         Int
  amountRefunded Int    @default(0)
  currency       String @default("INR")

  paymentMethod PaymentMethodKind?

  /// Free text from the provider ("upi/googlepay", "card/Visa 4242").
  methodDetail String?

  status PaymentStatus @default(CREATED)

  failureCode    String?
  failureMessage String?

  /// Raw provider payload of the last state change, for support and disputes.
  metadata Json?

  paidAt DateTime?

  attempts     PaymentAttempt[]
  refunds      Refund[]
  entitlements Entitlement[]
  invoice      Invoice?
  manualRecord ManualPaymentRecord?

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([provider, status])
  @@index([paymentMethod])
  @@index([paidAt])
  @@index([createdAt])
  @@index([providerOrderId])
  @@index([subscriptionId])
  @@map("payments")
}

/// One try at paying an order. Attempt 1 -> Razorpay -> failed, attempt 2 ->
/// Cashfree -> paid. Kept separate from Payment so retry history survives.
model PaymentAttempt {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// 1-based, unique per order.
  attemptNumber Int

  provider PaymentProvider
  method   PaymentMethodKind?

  status PaymentStatus @default(CREATED)

  /// Which routing rule chose this provider — null when the default answered.
  routingRuleId String?

  failureCode    String?
  failureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, attemptNumber])
  @@index([paymentId])
  @@index([provider, status])
  @@index([createdAt])
  @@map("payment_attempts")
}

/// Every webhook we accept, stored before it is acted on. The unique
/// (provider, eventId) is the idempotency guard: a redelivery collides on
/// insert instead of re-running the handler.
model PaymentWebhookEvent {
  id String @id @default(cuid())

  provider PaymentProvider

  /// The provider's own event id. Providers that send none get a hash of the
  /// payload, so a byte-identical redelivery still dedupes.
  eventId   String
  eventType String

  status WebhookEventStatus @default(RECEIVED)

  signatureValid Boolean @default(false)

  payload Json

  /// Payment this event resolved to, once known.
  paymentId String?

  attempts    Int       @default(0)
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([provider, eventType])
  @@index([paymentId])
  @@index([receivedAt])
  @@map("payment_webhook_events")
}

/// A refund is never SUCCEEDED because the API accepted the request — only
/// because the provider later said so (§14).
model Refund {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  provider         PaymentProvider
  providerRefundId String?

  /// Minor units.
  amount   Int
  currency String @default("INR")

  status RefundStatus @default(PENDING)

  reason         String?
  failureMessage String?

  /// Idempotency key sent to the provider, so a retried request never
  /// double-refunds.
  idempotencyKey String @unique

  requestedById String?
  requestedBy   User?   @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  metadata Json?

  creditNote CreditNote?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, providerRefundId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
  @@map("refunds")
}

/// A recurring plan the provider bills. We mirror its state rather than owning
/// it: the provider's mandate is what actually charges the card.
model Subscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Restrict)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  provider               PaymentProvider
  providerSubscriptionId String?

  /// Provider-side customer handle, reused across renewals.
  providerCustomerId String?

  status SubscriptionStatus @default(CREATED)

  interval BillingInterval

  /// Minor units, per cycle. Frozen at subscribe time — a later plan price
  /// change never silently re-prices an existing subscriber.
  amount   Int
  currency String @default("INR")

  startDate         DateTime?
  currentPeriodEnd  DateTime?
  nextBillingDate   DateTime?
  cancelledAt       DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  cancelReason      String?

  failedRenewals Int @default(0)

  /// Order that opened the subscription; renewals create their own orders.
  initialOrderId String? @unique
  initialOrder   Order?  @relation("SubscriptionInitialOrder", fields: [initialOrderId], references: [id], onDelete: SetNull)

  payments     Payment[]
  entitlements Entitlement[]

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@index([userId, status])
  @@index([status, nextBillingDate])
  @@index([planId])
  @@map("subscriptions")
}

/// Issued once, when an order is genuinely PAID. Numbering is gapless per year
/// via InvoiceSequence.
model Invoice {
  id String @id @default(cuid())

  /// NEXA-INV-2026-000001. Gapless within a year, allocated from
  /// InvoiceSequence under a row lock and never reused.
  number String @unique

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation("UserInvoices", fields: [userId], references: [id], onDelete: Restrict)

  status InvoiceStatus @default(ISSUED)

  /// Minor units, all frozen at issue time.
  subtotal       Int
  discountAmount Int     @default(0)
  discountCode   String?
  /// subtotal - discountAmount. Tax is charged on THIS, never the list price.
  taxableAmount  Int
  cgstAmount     Int     @default(0)
  sgstAmount     Int     @default(0)
  igstAmount     Int     @default(0)
  taxTotal       Int     @default(0)
  total          Int
  amountRefunded Int     @default(0)
  currency       String  @default("INR")

  taxTreatment   TaxTreatment @default(NONE)
  taxRatePercent Float        @default(0)
  taxLabel       String?

  /// Line items as rendered. Copied, never joined - a later plan rename must
  /// not rewrite a receipt someone already downloaded.
  lines Json

  /// Buyer identity, snapshotted. An invoice must not change when the user
  /// edits their profile afterwards.
  billingName       String
  billingEmail      String?
  billingPhone      String?
  billingLine1      String?
  billingLine2      String?
  billingCity       String?
  billingState      String?
  /// GST state code, derived from the buyer's GSTIN when they gave one.
  billingStateCode  String?
  billingPostalCode String?
  billingCountry    String  @default("IN")
  customerGstin     String?
  businessName      String?

  /// Seller identity, snapshotted from InvoiceSettings at issue time.
  seller Json

  /// Payment facts, copied so the receipt survives a payment row changing.
  /// methodDetail is always a provider-supplied safe descriptor
  /// (Visa ending 4242) - never a PAN, CVV, PIN or bank credential.
  paymentProvider PaymentProvider?
  paymentMethod   PaymentMethodKind?
  methodDetail    String?
  transactionId   String?

  notes  String?
  terms  String?
  footer String?

  /// The PDF artifact. `pdfStorageKey` is a private Cloudinary public_id; there
  /// is deliberately no permanently-public URL for a financial document.
  pdfStatus      InvoicePdfStatus @default(PENDING)
  pdfStorageKey  String?
  pdfUrl         String?
  pdfBytes       Int?
  pdfGeneratedAt DateTime?
  pdfAttempts    Int              @default(0)
  pdfError       String?

  /// Email dedupe. The flag is what stops a redelivered webhook sending a
  /// second copy.
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  invoiceDate DateTime  @default(now())
  dueDate     DateTime?
  paidAt      DateTime?

  creditNotes CreditNote[]
  auditLogs   InvoiceAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, invoiceDate])
  @@index([status])
  @@index([pdfStatus])
  @@index([paymentProvider])
  @@index([paymentMethod])
  @@index([currency])
  @@index([invoiceDate])
  @@map("invoices")
}

/// A credit note reverses value without touching the invoice it references -
/// an issued invoice is never rewritten after a refund.
model CreditNote {
  id String @id @default(cuid())

  /// NEXA-CN-2026-000001, from its own sequence.
  number String @unique

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("UserCreditNotes", fields: [userId], references: [id], onDelete: Restrict)

  /// The refund that caused it. Unique, so one refund can only ever produce
  /// one credit note however many times reconciliation re-runs.
  refundId String? @unique
  refund   Refund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  reason CreditNoteReason @default(REFUND)
  note   String?

  /// Minor units, positive. Tax is split back in the same proportion it was
  /// charged, so a partial credit never invents tax.
  subtotal   Int
  cgstAmount Int    @default(0)
  sgstAmount Int    @default(0)
  igstAmount Int    @default(0)
  taxTotal   Int    @default(0)
  total      Int
  currency   String @default("INR")

  isFullCredit Boolean @default(false)

  lines   Json
  billing Json
  seller  Json

  pdfStatus      InvoicePdfStatus @default(PENDING)
  pdfStorageKey  String?
  pdfBytes       Int?
  pdfGeneratedAt DateTime?
  pdfAttempts    Int              @default(0)
  pdfError       String?

  issuedAt DateTime @default(now())

  auditLogs InvoiceAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([userId, issuedAt])
  @@index([issuedAt])
  @@map("credit_notes")
}

/// Who an invoice is actually billed to.
///
/// Deliberately not the User row: a student account is usually paid for by a
/// parent, so the bill-payer's name, email and address are their own record.
/// Seeded from StudentProfile.parent* the first time a student checks out, and
/// editable by the buyer afterwards.
model BillingProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("UserBillingProfile", fields: [userId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  line1      String?
  line2      String?
  city       String?
  state      String?
  /// GST state code, derived from `gstin` when one is set.
  stateCode  String?
  postalCode String?
  country    String  @default("IN")

  gstin        String?
  businessName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("billing_profiles")
}

model CreditNoteSequence {
  year       Int @id
  lastNumber Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("credit_note_sequences")
}

/// Admin - Settings - Billing and Invoicing. A singleton: business details are
/// never hard-coded into the PDF template.
model InvoiceSettings {
  /// Always "default" - enforced by the service, which upserts on this id.
  id String @id @default("default")

  legalName String  @default("NexaChess")
  tradeName String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("IN")

  email   String?
  phone   String?
  website String?

  gstin String?
  pan   String?

  logoUrl String?

  invoicePrefix    String @default("NEXA-INV")
  creditNotePrefix String @default("NEXA-CN")

  defaultTaxPercent Float  @default(0)
  taxLabel          String @default("GST")

  footerText   String?
  termsText    String?
  supportEmail String?

  emailOnIssue     Boolean @default(true)
  attachPdfToEmail Boolean @default(true)

  /// Null until an admin saves, which is how the API reports `configured`.
  updatedAt   DateTime?
  updatedById String?
  updatedBy   User?     @relation("InvoiceSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("invoice_settings")
}

/// Invoice audit trail. Append-only; nothing updates or deletes a row.
model InvoiceAuditLog {
  id String @id @default(cuid())

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  creditNoteId String?
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  event InvoiceEventType

  /// Null for an automated action (webhook, cron, worker).
  actorId String?
  actor   User?   @relation("InvoiceAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@index([creditNoteId, createdAt])
  @@index([event, createdAt])
  @@map("invoice_audit_logs")
}

model InvoiceSequence {
  /// Calendar year the sequence belongs to.
  year       Int @id
  lastNumber Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("invoice_sequences")
}

/// What a payment actually bought. The ONLY thing that unlocks access — a
/// provider saying "paid" is not enough, and a frontend saying so is never
/// enough (§21).
model Entitlement {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserEntitlements", fields: [userId], references: [id], onDelete: Restrict)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  /// The order that granted it. Unique per (order, plan) so a replayed webhook
  /// can never grant the same benefit twice (§11).
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// Batch the student was enrolled into, when the plan names one.
  batchId String?
  batch   Batch?  @relation("EntitlementBatch", fields: [batchId], references: [id], onDelete: SetNull)

  status EntitlementStatus @default(ACTIVE)

  startsAt DateTime @default(now())

  /// Null = perpetual.
  endsAt DateTime?

  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, planId])
  @@index([userId, status])
  @@index([status, endsAt])
  @@index([planId])
  @@index([subscriptionId])
  @@map("entitlements")
}

/// Admin-managed catalogue of offline ways a student can pay (Cash, personal UPI/GPay,
/// bank transfer, …). Deactivate instead of delete once a record references one.
model OfflinePaymentMethod {
  id String @id @default(cuid())

  key      String  @unique
  label    String
  isActive Boolean @default(true)

  sortOrder Int @default(0)

  manualPayments ManualPaymentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("offline_payment_methods")
}

/// One manual/offline payment recorded by an admin or coach for tracking — cash,
/// personal UPI, bank transfer. 1:1 with the Payment it produces (provider MANUAL).
///
/// A coach's record starts PENDING and grants nothing until an admin approves it —
/// approval runs the SAME PaymentService.applyProviderState funnel a real gateway
/// capture uses (§3.6f), so the entitlement, invoice and PAYMENT_RECEIVED messaging
/// are identical to an online payment. An admin's own record is auto-approved.
///
/// Not soft-deletable / not Trash-registered — a financial record is never trashed.
model ManualPaymentRecord {
  id String @id @default(cuid())

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  methodId String
  method   OfflinePaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)

  /// Free text: a UPI transaction id, cheque number, a note.
  reference String?

  recordedByUserId String
  recordedByUser   User     @relation("ManualPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  recordedByRole   UserRole

  status OfflinePaymentReviewStatus @default(PENDING)

  reviewedByUserId String?
  reviewedByUser   User?     @relation("ManualPaymentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  rejectionReason  String?

  /// Optional proof of payment (a screenshot or a PDF receipt). Captured at record
  /// time only — there is no edit-after-the-fact route. `attachmentKey` is a
  /// Cloudinary public_id (private/authenticated/raw), never a public URL.
  attachmentKey       String?
  attachmentFileName  String?
  attachmentMimeType  String?
  attachmentSizeBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([recordedByUserId])
  @@map("manual_payment_records")
}

/// Raw material for provider health (§17). One row per outbound API call and
/// per inbound webhook, pruned on a schedule.
model PaymentProviderEvent {
  id String @id @default(cuid())

  provider PaymentProvider
  kind     PaymentProviderEventKind

  /// "createPayment", "refundPayment", "webhook:payment.captured".
  operation String

  success    Boolean
  durationMs Int?
  statusCode Int?
  errorCode  String?

  createdAt DateTime @default(now())

  @@index([provider, createdAt])
  @@index([createdAt])
  @@map("payment_provider_events")
}

/// Singleton holding the admin-editable routing config. Lazily created from
/// DEFAULT_PAYMENT_ROUTING in @nexa-chess/types, like LiveClassPolicy.
model PaymentSetting {
  id       String  @id @default(cuid())
  isActive Boolean @default(true)

  /// PaymentRoutingConfig JSON, validated by the shared Zod schema.
  routing Json

  updatedById String?
  updatedBy   User?   @relation("PaymentSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

/// A discount is the one mechanism that changes what someone pays. A launch
/// code, a UPI-only offer and a batch-specific deal are the same row with a
/// different scope, so there is a single place to audit why an order cost what
/// it did.
model Discount {
  id String @id @default(cuid())

  /// Stored uppercase and matched uppercase, so "diwali25" is the same code.
  code        String  @unique
  name        String
  description String?

  type DiscountType

  /// PERCENTAGE: whole percent (25 = 25%). FIXED: minor units.
  value Int

  /// FIXED only — the code is refused in any other currency, because "₹500
  /// off" is not "$500 off".
  currency String?

  /// PERCENTAGE only: the most this code may ever take off. Minor units.
  maxDiscountAmount Int?

  /// Minimum order subtotal for the code to apply. Minor units.
  minOrderAmount Int?

  startsAt DateTime?
  endsAt   DateTime?

  /// Total redemptions across everyone. Null = unlimited.
  maxRedemptions Int?
  maxPerUser     Int  @default(1)

  /// Denormalised counter, incremented in the same transaction as the
  /// redemption row, so validation never has to count rows.
  redemptionCount Int @default(0)

  /// Scope. Empty means "everything" for each dimension.
  planIds  String[]
  batchIds String[]
  /// How a method-specific offer is expressed ("10% off on UPI").
  methods  PaymentMethodKind[]

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("DiscountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  redemptions DiscountRedemption[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
  @@map("discounts")
}

/// Written when an order is actually PAID, never when it is created — an
/// abandoned checkout must not burn a limited code.
model DiscountRedemption {
  id String @id @default(cuid())

  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("DiscountRedemptions", fields: [userId], references: [id], onDelete: Restrict)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// Minor units actually taken off.
  amount Int

  createdAt DateTime @default(now())

  @@unique([discountId, orderId])
  @@index([discountId, userId])
  @@map("discount_redemptions")
}

//
// COACH PAYROLL & PAYSLIPS
//
// Computes what each coach is owed for a period from actual teaching activity
// — CoachClass / CoachAttendance / ClassAttendance are read, never
// re-derived; AttendanceService.finalizeClassAttendance stays the only place
// actual teaching time is computed. Admins review/adjust/approve/finalize the
// result and issue a PDF document. Entirely separate from the PAYMENTS
// section above: a student's Invoice and a coach's Payslip are different
// financial documents for different parties.
//
// Nothing here is soft-deletable. A financial record is never trashed.
//

enum CoachEngagementType {
  EMPLOYEE
  CONTRACTOR
  FREELANCER
  OTHER
}

enum CoachCompensationModel {
  HOURLY
  PER_CLASS
  FIXED_SALARY
  HOURLY_PLUS_CLASS
  TIERED
  PERCENTAGE
  HYBRID
}

enum CompensationCalculationType {
  HOURLY_RATE
  PER_CLASS_RATE
  MONTHLY_SALARY
  TIER
  PERCENTAGE
}

enum PayrollRuleType {
  CANCELLATION
  ATTENDANCE
  BONUS
  DEDUCTION
}

enum PayrollPeriodType {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATING
  REVIEW
  APPROVED
  FINALIZED
  PAID
  CANCELLED
}

enum CoachPayrollRecordStatus {
  PENDING
  CALCULATED
  REVIEWED
  APPROVED
  FINALIZED
  PAID
}

enum PayrollAdjustmentType {
  EARNING
  DEDUCTION
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayslipDocumentKind {
  PAYSLIP
  PAYMENT_STATEMENT
}

/// The PDF artifact's own state, separate from the payroll record's financial
/// status — mirrors InvoicePdfStatus. A failed render must never make a
/// finalized/paid payroll record look unresolved.
enum PayslipPdfStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

/// Per-coach compensation configuration, 1:1 with a coach. Created lazily
/// (default EMPLOYEE / HOURLY) the first time an admin opens a coach's payroll
/// settings.
model CoachCompensationProfile {
  id String @id @default(cuid())

  coachId String @unique
  coach   User   @relation("CoachCompensationProfile", fields: [coachId], references: [id], onDelete: Restrict)

  engagementType           CoachEngagementType    @default(EMPLOYEE)
  defaultCompensationModel CoachCompensationModel @default(HOURLY)
  currency                 String                 @default("INR")

  paymentMethod  String?
  /// Bank/UPI details. Access-restricted: never returned to a non-admin
  /// caller, never written into TrashAuditLog metadata, never included in a
  /// notification body.
  paymentDetails Json?

  /// Tax/compliance placeholders (§29). Nullable, unused by any calculation
  /// today — extensibility only.
  panNumber    String?
  gstin        String?
  taxTreatment String?

  notes String?

  createdById String?
  createdBy   User?   @relation("CoachCompensationProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  rates CoachCompensationRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coach_compensation_profiles")
}

/// Effective-dated rate rows. A "rate change" always closes the previous
/// row's effectiveTo and inserts a new row — never mutates a past rate's
/// value in place, so a historical payroll period always resolves the rate
/// that was actually in force when it ran.
model CoachCompensationRate {
  id String @id @default(cuid())

  coachId String
  coach   User   @relation("CoachCompensationRate", fields: [coachId], references: [id], onDelete: Restrict)

  compensationProfileId String?
  compensationProfile   CoachCompensationProfile? @relation(fields: [compensationProfileId], references: [id], onDelete: SetNull)

  compensationModel CoachCompensationModel
  calculationType   CompensationCalculationType

  /// Flat hourly / per-class / monthly value, minor units.
  rateMinor     Int?
  /// PERCENTAGE model, basis points (10000 = 100%) — no floats.
  percentageBps Int?
  /// Ordered tier breakpoints for TIERED, e.g. [{ uptoHours, rateMinor }, ...].
  tierConfig    Json?
  /// Optional scoping: { classTypes?, studentLevels?, batchIds? }. Unscoped
  /// (null) applies to everything not covered by a more specific row.
  scopeConfig   Json?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdById String?
  createdBy   User?   @relation("CoachCompensationRateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId, effectiveFrom])
  @@map("coach_compensation_rates")
}

/// Configurable cancellation / attendance / bonus / deduction rules the
/// calculation engine applies on top of the base rate. Effective-dated like
/// CoachCompensationRate, so a rule change never rewrites a past payroll
/// period's already-frozen ruleSnapshot.
model PayrollRule {
  id String @id @default(cuid())

  name        String
  description String?
  ruleType    PayrollRuleType

  /// Structured predicate, e.g. { cancelledBy: "COACH" } or
  /// { cancelledBy: "STUDENT", noticeHours: { lt: 2 } }.
  condition Json
  /// Structured effect, e.g. { payoutPercent: 0 } or { flatAmountMinor: 5000 }.
  effect    Json

  priority Int     @default(0)
  enabled  Boolean @default(true)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdById String?
  createdBy   User?   @relation("PayrollRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleType, enabled])
  @@map("payroll_rules")
}

/// A payroll run for a date range, covering every in-scope coach. Statuses
/// only ever move forward (DRAFT → CALCULATING → REVIEW → APPROVED →
/// FINALIZED → PAID), or sideways into CANCELLED. Once FINALIZED, nothing
/// about a period's already-produced CoachPayrollRecord rows may silently
/// change — a correction is a PayrollAdjustment, never an edit (§31).
model PayrollPeriod {
  id String @id @default(cuid())

  periodType PayrollPeriodType
  startDate  DateTime          @db.Date
  endDate    DateTime          @db.Date

  status PayrollPeriodStatus @default(DRAFT)

  createdById String?
  createdBy   User?   @relation("PayrollPeriodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  calculatedAt  DateTime?
  approvedById  String?
  approvedBy    User?     @relation("PayrollPeriodApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  finalizedById String?
  finalizedBy   User?     @relation("PayrollPeriodFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  finalizedAt   DateTime?
  paidAt        DateTime?

  notes String?

  records CoachPayrollRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodType, startDate, endDate])
  @@index([status])
  @@index([startDate, endDate])
  @@map("payroll_periods")
}

/// One coach's calculated payroll within a period. The teaching-summary
/// counts are read (never re-derived) from
/// CoachClass/CoachAttendance/ClassAttendance; rateSnapshot/ruleSnapshot
/// freeze exactly which CoachCompensationRate/PayrollRule rows produced
/// earningsBreakdown, so a later rate/rule edit can never retroactively
/// change a finalized record (§14/§31).
model CoachPayrollRecord {
  id String @id @default(cuid())

  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  coachId String
  coach   User   @relation("CoachPayrollRecordCoach", fields: [coachId], references: [id], onDelete: Restrict)

  status CoachPayrollRecordStatus @default(PENDING)

  scheduledClassesCount   Int @default(0)
  completedClassesCount   Int @default(0)
  cancelledByCoachCount   Int @default(0)
  cancelledByStudentCount Int @default(0)
  cancelledByAdminCount   Int @default(0)
  noShowCount             Int @default(0)
  totalTeachingSeconds    Int @default(0)
  totalBoardSeconds       Int @default(0)

  /// Versioned, explainable breakdown: { version: 1, lineItems: [{ label,
  /// quantity?, rateMinor?, amountMinor, source }] } (§11).
  earningsBreakdown Json?
  /// The CoachCompensationRate row(s) actually applied, frozen at calc time.
  rateSnapshot      Json?
  /// The PayrollRule row(s) actually applied, frozen at calc time.
  ruleSnapshot      Json?

  grossEarningsMinor    Int @default(0)
  totalDeductionsMinor  Int @default(0)
  totalAdjustmentsMinor Int @default(0)
  netPayableMinor       Int @default(0)

  calculatedAt DateTime?
  reviewedAt   DateTime?
  approvedAt   DateTime?
  finalizedAt  DateTime?

  adjustments PayrollAdjustment[]
  payout      CoachPayout?
  payslip     Payslip?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, coachId])
  @@index([coachId])
  @@index([status])
  @@map("coach_payroll_records")
}

/// A manual earning or deduction on top of the calculated record (§9). Never
/// hard-deleted once the record is past REVIEW — a correction reverses it
/// (reversedById/reversedAt/reversalReason) instead, keeping the row for
/// audit.
model PayrollAdjustment {
  id String @id @default(cuid())

  payrollRecordId String
  payrollRecord   CoachPayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Restrict)

  type        PayrollAdjustmentType
  description String
  amountMinor Int
  reason      String

  createdById String?
  createdBy   User?   @relation("PayrollAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  reversedById   String?
  reversedBy     User?     @relation("PayrollAdjustmentReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  reversedAt     DateTime?
  reversalReason String?

  createdAt DateTime @default(now())

  @@index([payrollRecordId])
  @@map("payroll_adjustments")
}

/// Payout tracking, deliberately separate from the payroll calculation itself
/// (§22). With no bank-transfer integration yet, "Mark as Paid Manually" with
/// a reference/date/method/notes is the only path to PAID.
model CoachPayout {
  id String @id @default(cuid())

  payrollRecordId String             @unique
  payrollRecord   CoachPayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  status    PayoutStatus @default(PENDING)
  method    String?
  reference String?
  paidAt    DateTime?
  notes     String?

  adminId String?
  admin   User?   @relation("CoachPayoutAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("coach_payouts")
}

/// The PDF artifact: "Payslip" for an EMPLOYEE coach, "Coach Payment
/// Statement" for CONTRACTOR/FREELANCER/OTHER (§17) — engagementTypeAtIssue
/// freezes which framing was used so a later engagement-type change never
/// rewrites an already-issued document.
model Payslip {
  id String @id @default(cuid())

  /// NEXA-PAY-2026-000001. Gapless within a year, allocated from
  /// PayslipSequence under a row lock and never reused.
  documentNumber String @unique

  payrollRecordId String             @unique
  payrollRecord   CoachPayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Restrict)

  documentKind          PayslipDocumentKind
  engagementTypeAtIssue CoachEngagementType

  /// Private Cloudinary public_id — no permanently-public URL, mirrors Invoice.
  storageKey  String?
  pdfStatus   PayslipPdfStatus @default(PENDING)
  pdfError    String?
  pdfAttempts Int              @default(0)

  issuedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pdfStatus])
  @@map("payslips")
}

model PayslipSequence {
  /// Calendar year the sequence belongs to.
  year       Int @id
  lastNumber Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("payslip_sequences")
}

// ──────────────────────────────────────────────
// Coach feedback & ratings. An admin authors a FeedbackForm (its questions are
// a JSON array of `FeedbackQuestion` from @nexa-chess/types, edited wholesale),
// decides WHEN it is asked (`trigger`) and WHERE the student sees it
// (`placements`). "Pending" is computed on read — there is no request row — and
// a FeedbackResponse (submitted or skipped) is what closes one. The unique
// (form, student, coach, contextKey) is the double-submit guard.
// Not soft-deletable, not Trash-registered: a form with responses can only be
// deactivated, never deleted.
// ──────────────────────────────────────────────

enum FeedbackTrigger {
  AFTER_CLASS
  RECURRING
  ONE_TIME
}

enum FeedbackPlacement {
  CLASS_END
  DASHBOARD_POPUP
  DASHBOARD_CARD
}

enum FeedbackResponseStatus {
  SUBMITTED
  SKIPPED
}

model FeedbackForm {
  id          String  @id @default(cuid())
  title       String
  description String?
  isActive    Boolean @default(true)

  /// FeedbackQuestion[] — stable ids so answers survive later edits.
  questions Json

  trigger          FeedbackTrigger
  /// AFTER_CLASS: ask after every Nth attended class with the same coach.
  classInterval    Int                 @default(1)
  /// RECURRING: ask once per coach every N days.
  intervalDays     Int?
  /// How long an unanswered request stays open.
  expiresAfterDays Int                 @default(7)
  placements       FeedbackPlacement[]
  /// Empty = every batch.
  batchIds         String[]

  startsAt DateTime?
  endsAt   DateTime?

  allowSkip   Boolean @default(true)
  /// Coaches see their own aggregate + anonymous comments from this form.
  showToCoach Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("FeedbackFormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  responses FeedbackResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("feedback_forms")
}

model FeedbackResponse {
  id String @id @default(cuid())

  formId String
  form   FeedbackForm @relation(fields: [formId], references: [id], onDelete: Restrict)

  studentId String
  student   User   @relation("FeedbackResponseStudent", fields: [studentId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("FeedbackResponseCoach", fields: [coachId], references: [id], onDelete: Cascade)

  classId String?
  class   CoachClass? @relation("FeedbackResponseClass", fields: [classId], references: [id], onDelete: SetNull)

  /// `class:<id>` | `period:<n>` | `once` — what this response answers.
  contextKey String

  status        FeedbackResponseStatus
  /// Mean of this response's RATING answers (1-5); null if none / skipped.
  overallRating Float?

  answers FeedbackAnswer[]

  createdAt DateTime @default(now())

  @@unique([formId, studentId, coachId, contextKey])
  @@index([coachId, status])
  @@index([studentId])
  @@index([createdAt])
  @@map("feedback_responses")
}

model FeedbackAnswer {
  id String @id @default(cuid())

  responseId String
  response   FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  /// Snapshot of the question at submit time, so a later edit never rewrites
  /// what the student was actually asked.
  questionId    String
  questionLabel String
  questionType  String

  ratingValue Int?
  textValue   String?

  @@index([responseId])
  @@index([questionId])
  @@map("feedback_answers")
}

// ──────────────────────────────────────────────
// COACH CLASS-CHANGE REQUESTS
// ──────────────────────────────────────────────

enum ClassRequestType {
  EXTRA_CLASS
  RESCHEDULE
}

enum ClassRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A coach asking for an extra class or to move a scheduled one. Coaches never
/// create or move classes themselves — an admin approving this does. Not
/// soft-deletable; a decided request is history. A partial unique index (hand
/// written in the migration) allows one PENDING reschedule per class.
model ClassChangeRequest {
  id     String             @id @default(cuid())
  type   ClassRequestType
  status ClassRequestStatus @default(PENDING)

  coachId String
  coach   User        @relation("ClassChangeRequestCoach", fields: [coachId], references: [id], onDelete: Cascade)
  batchId String
  batch   Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// RESCHEDULE: the class to move. EXTRA_CLASS: the class created on approval.
  classId String?
  class   CoachClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  startsAt         DateTime
  endsAt           DateTime
  /// RESCHEDULE: the class's time when asked, so the admin sees from → to.
  originalStartsAt DateTime?
  originalEndsAt   DateTime?
  topic            String?
  reason           String?

  reviewedById String?
  reviewedBy   User?     @relation("ClassChangeRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([coachId])
  @@index([classId])
  @@map("class_change_requests")
}

// ──────────────────────────────────────────────
// STUDENT PROGRESS (puzzle rating + practice streak)
// ──────────────────────────────────────────────

/// One row per student, created on their first rated puzzle or practice day.
model StudentProgress {
  studentId     String    @id
  student       User      @relation("StudentProgress", fields: [studentId], references: [id], onDelete: Cascade)
  puzzleRating  Int       @default(1200)
  peakRating    Int       @default(1200)
  ratedPuzzles  Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  /// Local calendar day (student's timezone) of the last practice.
  lastActiveDay DateTime? @db.Date
  updatedAt     DateTime  @updatedAt

  @@map("student_progress")
}

/// One rated puzzle result. Unique per (student, puzzle): only the first
/// finished attempt at a puzzle is rated, and a replayed submit can't rate twice.
model PuzzleRatingChange {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("StudentPuzzleRatingChanges", fields: [studentId], references: [id], onDelete: Cascade)
  puzzleId     String
  attemptId    String   @unique
  puzzleRating Int
  before       Int
  after        Int
  createdAt    DateTime @default(now())

  @@unique([studentId, puzzleId])
  @@index([studentId, createdAt])
  @@map("puzzle_rating_changes")
}

// ──────────────────────────────────────────────
// JOB LOCKS (cron single-runner leases, see JobLockService)
// ──────────────────────────────────────────────

/// One row per cron. A run holds it while `lockedUntil` is in the future.
model JobLock {
  name        String   @id
  owner       String
  acquiredAt  DateTime
  lockedUntil DateTime

  @@map("job_locks")
}

/// Raw Lichess puzzle dump (CC0, database.lichess.org). SOURCE DATA ONLY:
/// written exclusively by the catalogue load script, never by the API.
/// Not soft-deletable, not Trash-registered, no FK in or out, table data
/// excluded from backups (reproducible from the prepared release in OCI).
/// See docs/PUZZLE_CATALOGUE_IMPLEMENTATION_SPEC.md §1.
model LichessPuzzle {
  id                String    @id // Lichess PuzzleId, e.g. "0000D"
  fen               String // position BEFORE moves[0], as published
  moves             String // UCI, space separated, as published (2–34 plies)
  rating            Int       @db.SmallInt // Lichess Glicko-2 puzzle rating
  ratingDeviation   Int       @db.SmallInt
  popularity        Int       @db.SmallInt // −100…100
  nbPlays           Int
  themes            String[] // Lichess theme keys (LICHESS_THEMES)
  openingTags       String[]  @default([])
  gameUrl           String
  ratingBand        Int       @db.SmallInt // floor(rating / 50)
  randKey           Int // stable: first 31 bits of sha1(id)
  contentHash       String // puzzleContentHash of the post-setup position + line
  /// Passes the catalogue INGESTION gate (source quality + not a duplicate +
  /// not retired). Says nothing about whether a puzzle suits a student — that
  /// is the training policy's job, computed per request.
  passesQualityGate Boolean
  retiredAt         DateTime? // set when a refresh no longer contains the id
  releaseId         String // LichessCatalogueRelease.id that last wrote the row (no FK)

  @@index([ratingBand, randKey, id], map: "lichess_puzzles_walk_idx")
  @@index([themes], type: Gin, map: "lichess_puzzles_themes_gin")
  @@index([openingTags], type: Gin, map: "lichess_puzzles_opening_gin")
  @@map("lichess_puzzles")
}

/// One loaded catalogue release. Tiny and backed up: after a restore it names
/// the exact OCI artifact to reload. Also the load script's resume state.
model LichessCatalogueRelease {
  id              String    @id // preparedSha256
  formatVersion   Int
  lichessDumpDate DateTime  @db.Date
  sourceSha256    String
  manifest        Json // the full manifest, verbatim
  validRows       Int
  qualityGateRows Int
  loadStartedAt   DateTime  @default(now())
  loadCompletedAt DateTime? // null = load in progress or interrupted

  @@map("lichess_catalogue_releases")
}
