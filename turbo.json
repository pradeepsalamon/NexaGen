{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_STANDALONE", "SENTRY_ORG", "SENTRY_PROJECT", "SENTRY_RELEASE"],
      "passThroughEnv": ["CI", "SENTRY_AUTH_TOKEN"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".next-build/**", "!.next-build/cache/**", "public/vendor/pdfjs/**", "public/vendor/tesseract/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
