{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexa AI Work Order",
  "type": "object",
  "required": ["task_id", "title", "objective", "priority", "type", "environment", "requirements", "acceptance_criteria", "required_tests", "safety"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^NEXA-\\d{4}$",
      "description": "Unique task identifier"
    },
    "title": {
      "type": "string",
      "description": "Short, descriptive title"
    },
    "objective": {
      "type": "string",
      "description": "What this task should accomplish"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "type": {
      "type": "string",
      "enum": ["feature_implementation", "bug_fix", "investigation", "refactor", "devops", "database", "research", "code_review", "testing", "documentation"]
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "medium", "complex"]
    },
    "problem_statement": {
      "type": "string",
      "description": "Precise formulation of the problem, bug, or feature request"
    },
    "attempt": {
      "type": "integer",
      "default": 1
    },
    "max_attempts": {
      "type": "integer",
      "default": 2
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Required worker capability tags (e.g. backend, nestjs, prisma, frontend, nextjs, testing)"
    },
    "worktree_path": {
      "type": "string",
      "description": "Path to isolated worker git worktree (e.g. /opt/nexa-chess/NexaGen-dev/.worktrees/nexa-dev-01)"
    },
    "task_branch": {
      "type": "string",
      "description": "Target git branch checked out in worker worktree (e.g. ai/NEXA-0001-desc)"
    },
    "worktree_status": {
      "type": "string",
      "enum": ["AVAILABLE", "ASSIGNED", "CREATING", "READY", "RUNNING", "TESTING", "COMPLETED", "RELEASED", "DIRTY", "ORPHANED", "INTERRUPTED", "BLOCKED"],
      "default": "AVAILABLE"
    },
    "worktree_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "properties": {
        "server": { "type": "string", "default": "nexa-vcn" },
        "environment": { "type": "string", "enum": ["development", "production"], "default": "development" },
        "project_path": { "type": "string", "default": "/opt/nexa-chess/NexaGen-dev" },
        "branch": { "type": "string", "description": "Task branch name (e.g., ai/NEXA-0001-desc)" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "relevant_files": { "type": "array", "items": { "type": "string" } },
        "related_models": { "type": "array", "items": { "type": "string" } },
        "affected_apps": { "type": "array", "items": { "type": "string" } },
        "affected_packages": { "type": "array", "items": { "type": "string" } },
        "architecture_notes": { "type": "string" }
      }
    },
    "affected_areas": {
      "type": "object",
      "properties": {
        "known": { "type": "array", "items": { "type": "string" } },
        "inferred": { "type": "array", "items": { "type": "string" } },
        "unknown": { "type": "array", "items": { "type": "string" } }
      }
    },
    "impact_analysis": {
      "type": "object",
      "properties": {
        "database_impact": { "type": "boolean" },
        "redis_impact": { "type": "boolean" },
        "livekit_impact": { "type": "boolean" },
        "api_impact": { "type": "boolean" },
        "frontend_impact": { "type": "boolean" }
      }
    },
    "instructions": {
      "type": "string",
      "description": "Explicit instructions for coding worker regarding inspection, reuse, and pattern adherence"
    },
    "investigation_instructions": {
      "type": "string",
      "description": "Step-by-step guidance for investigation and root cause analysis"
    },
    "implementation_guidance": {
      "type": "string",
      "description": "Implementation considerations, safety notes, and pattern reuse guidance"
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "impact": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "default": "MEDIUM"
    },
    "qa_tier": {
      "type": "string",
      "enum": ["docs_only", "backend_logic", "database_schema", "frontend_ui", "high_risk_full"],
      "default": "backend_logic"
    },
    "historical_context": {
      "type": "object",
      "properties": {
        "related_tasks": { "type": "array", "items": { "type": "string" } },
        "previous_learnings": { "type": "string" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "verification": { "type": "string", "enum": ["unit_test", "integration_test", "e2e_test", "typecheck", "lint", "build", "manual_review", "investigation"] },
              "mandatory": { "type": "boolean", "default": true }
            },
            "required": ["description"]
          }
        ]
      },
      "minItems": 1
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string", "enum": ["typecheck", "lint", "build", "unit_tests", "e2e_tests", "api_smoke_test"] }
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety": {
      "type": "object",
      "properties": {
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "blocked_paths": { "type": "array", "items": { "type": "string" } },
        "allowed_databases": { "type": "array", "items": { "type": "string" } },
        "blocked_databases": { "type": "array", "items": { "type": "string" } },
        "requires_approval": { "type": "boolean", "default": false }
      }
    },
    "state_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    },
    "assigned_worker": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "timeout_minutes": { "type": "integer", "default": 30 }
  }
}
