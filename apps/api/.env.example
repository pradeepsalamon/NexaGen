DATABASE_URL=postgresql://postgres:password@localhost:5432/nexa_chess
ADMIN_PASSWORD=1234567809
ADMIN_AUTH_SECRET=change-this-random-cookie-secret
JWT_ACCESS_SECRET=change-this-access-token-secret
JWT_REFRESH_SECRET=change-this-refresh-token-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_SHORT_TTL=1d
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Blank locally (localhost/IP hosts get no cookie domain). In prod, leave blank to
# auto-derive ".yourdomain.com" from FRONTEND_URL, or set explicitly.
COOKIE_DOMAIN=
PORT=3001
NODE_ENV=development
# Trusted proxy hops in front of the API (nginx = 1). Controls X-Forwarded-For
# parsing for rate-limiting and secure-cookie detection. 0 = trust none.
TRUST_PROXY_HOPS=0

LIVEKIT_URL=wss://test.livekit.cloud
LIVEKIT_API_KEY=key
LIVEKIT_API_SECRET=secret

CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@gmail.com
SMTP_PASS=pass
SMTP_FROM=user@gmail.com

NEXT_PUBLIC_CONTACT_EMAIL=info@nexa.com
ADMIN_EMAILS=admin1@nexa.com,admin2@nexa.com
TRASH_RETENTION_DAYS=30
STOCKFISH_PATH=F:/stockfish/stockfish-windows-x86-64-avx2.exe
STOCKFISH_POOL_SIZE=4
# Per-position search time in ms for the engine panel (deeper = stronger, slower).
STOCKFISH_MOVETIME=800

# Local recording storage (path inside the container; mounted 1:1 with the host).
RECORDING_STORAGE_DIR=/recordings
RECORDING_STORAGE_LIMIT_GB=130
RECORDING_MIN_RETENTION_DAYS=14
# "local" (default) writes recordings to RECORDING_STORAGE_DIR; "oci" makes
# egress upload straight to the bucket, bypassing quota/retention/analytics.
RECORDING_STORAGE_TARGET=local

# OCI Object Storage — DB backups + recording download fallback.
OCI_REGION=ap-mumbai-1
OCI_NAMESPACE=your_oci_namespace
OCI_BUCKET_NAME=your_backup_bucket
OCI_ACCESS_KEY_ID=your_oci_access_key
OCI_SECRET_ACCESS_KEY=your_oci_secret_key
