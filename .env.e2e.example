NODE_ENV=development

# API — must match the throwaway stack the specs run against. Never reuse
# production or vps_dev values here.
PORT=3001
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-random-64-char-value
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_SHORT_TTL=1d
LOGIN_RESPONSE_DELAY=500ms
LIVEKIT_URL=ws://localhost:7880
# Used by e2e/fixtures.ts to sign LiveKit webhooks; must equal the API's pair.
LIVEKIT_API_KEY=replace-with-your-local-livekit-key
LIVEKIT_API_SECRET=replace-with-your-local-livekit-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexa_gen?schema=public

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
