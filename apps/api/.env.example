DATABASE_URL=postgresql://postgres:password@localhost:5432/nexa_chess
ADMIN_PASSWORD=1234567809
ADMIN_AUTH_SECRET=change-this-random-cookie-secret
JWT_ACCESS_SECRET=change-this-access-token-secret
JWT_REFRESH_SECRET=change-this-refresh-token-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_SHORT_TTL=1d
# Two-factor sign-in. Leave empty locally to skip it; any 32+ char value turns it on.
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=SUPER_ADMIN,ADMIN
# Constant-time-ish auth responses so a client can't tell "wrong password" from
# "no such account" apart by response latency.
LOGIN_RESPONSE_DELAY=500ms
PASSWORD_RESET_RESPONSE_DELAY=5s
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Blank locally (localhost/IP hosts get no cookie domain). In prod, leave blank to
# auto-derive ".yourdomain.com" from FRONTEND_URL, or set explicitly.
COOKIE_DOMAIN=
# lax | strict | none. "none" only if the API is on a different registrable domain.
COOKIE_SAME_SITE=lax
PORT=3001
NODE_ENV=development
# Default debug outside production (pretty-printed). JWT secrets must be 32+ chars when NODE_ENV=production.
LOG_LEVEL=debug
# Trusted proxy hops in front of the API (nginx = 1). Controls X-Forwarded-For
# parsing for rate-limiting and secure-cookie detection. 0 = trust none.
TRUST_PROXY_HOPS=0

LIVEKIT_URL=wss://test.livekit.cloud
LIVEKIT_API_KEY=key
LIVEKIT_API_SECRET=secret

CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@gmail.com
SMTP_PASS=pass
SMTP_FROM=user@gmail.com

NEXT_PUBLIC_CONTACT_EMAIL=info@nexa.com
# Web only: public site origin for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
ADMIN_EMAILS=admin1@nexa.com,admin2@nexa.com
TRASH_RETENTION_DAYS=30

# ── BullMQ (background jobs) ──────────────────────────────────────────────────
# Unset disables every queue: the API still boots, but nothing is processed and
# queued jobs are dropped. Start Redis locally with `npm run prod:db`.
REDIS_URL=redis://127.0.0.1:6379
# Namespaces the BullMQ keys — this Redis is shared with LiveKit and egress.
QUEUE_PREFIX=nexa
# Jobs a single worker runs in parallel.
QUEUE_CONCURRENCY=5

# ── WhatsApp Cloud API (outbound messages) ───────────────────────────────────
# Unset ACCESS_TOKEN / PHONE_NUMBER_ID leaves WhatsAppService unconfigured:
# callers degrade, nothing breaks. Both come from Meta -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
# Digits only, no "+". Expands a national number (e.g. 09876543210) to E.164.
WHATSAPP_DEFAULT_COUNTRY_CODE=
WHATSAPP_TIMEOUT_MS=10000

STOCKFISH_PATH=F:/stockfish/stockfish-windows-x86-64-avx2.exe
# Max engine processes; they start on demand and idle ones above the minimum are stopped.
STOCKFISH_POOL_SIZE=4
# Engines kept running at rest (~180 MB each)
STOCKFISH_MIN_ENGINES=1
# Seconds an extra engine may sit idle before it is stopped (0 = never)
STOCKFISH_IDLE_TIMEOUT_S=60
# Per-position search time in ms for the engine panel (deeper = stronger, slower).
STOCKFISH_MOVETIME=800
# Think time for the "engine move" button (full strength)
STOCKFISH_MOVE_MOVETIME=1000
# Engine moves return as soon as they reach this depth, even before MOVE_MOVETIME (0 = always use the full time)
STOCKFISH_MOVE_MAX_DEPTH=22
# Transposition table per engine process
STOCKFISH_HASH_MB=64
# Analysis returns as soon as it reaches this depth, even before MOVETIME (0 = always use the full time)
STOCKFISH_MAX_DEPTH=20

# ── Game analysis (docs/GAME_ANALYSIS.md) ─────────────────────────────────────
# Stockfish post-game analysis. Jobs are game_analyses rows run on the engine
# pool's background lane inside the API (one engine, one thread each).
GAME_ANALYSIS_ENABLED=true
# Run queued analyses in this process (false = only queue them)
GAME_ANALYSIS_WORKER=true
# Games analysed at once (1-4). Each takes one core while it runs.
GAME_ANALYSIS_CONCURRENCY=1
# Analyses one user may request per UTC day
GAME_ANALYSIS_DAILY_LIMIT=20
# Queue every finished live-class game automatically (CPU cost: ~50 s of one core per game)
GAME_ANALYSIS_AUTO_LIVE_GAMES=false
# Import students' own games from linked Lichess / Chess.com accounts (public APIs, username only)
EXTERNAL_GAME_IMPORT_ENABLED=false

# ── AI runtime (docs/ai/architecture/PHASE1_SPEC.md) ─────────────────────────
# Off by default. Only the compose.ai.yml overlay passes these to the api
# container. Enabling needs a secret of 32+ chars that is not a JWT secret
# (openssl rand -base64 48); the API refuses to boot otherwise.
AI_ENABLED=false
# AI_RUNTIME_URL=http://ai-runtime:8000
# AI_RUNTIME_SHARED_SECRET=
# AI_RUNTIME_TIMEOUT_MS=5000

# ── Admin analytics ───────────────────────────────────────────────────────────
# Thresholds that drive the operations-health warnings, plus how long a
# computed analytics response is cached (0 disables caching).
ANALYTICS_STORAGE_WARN_PERCENT=70
ANALYTICS_STORAGE_CRITICAL_PERCENT=85
ANALYTICS_LOW_ATTENDANCE_PERCENT=75
ANALYTICS_INACTIVE_DAYS=30
ANALYTICS_CACHE_TTL_SECONDS=300

# Local recording storage (path inside the container; mounted 1:1 with the host).
RECORDING_STORAGE_DIR=/recordings
RECORDING_STORAGE_LIMIT_GB=130
RECORDING_MIN_RETENTION_DAYS=14
# Auto-end a live class after the coach is gone this long / this far past its scheduled end (0 = off)
LIVE_CLASS_COACH_ABSENT_GRACE_MINUTES=10
LIVE_CLASS_MAX_OVERRUN_MINUTES=60
# "local" (default) writes recordings to RECORDING_STORAGE_DIR; "oci" makes
# egress upload straight to the bucket, bypassing quota/retention/analytics.
RECORDING_STORAGE_TARGET=local
# Egress recording template base URL, as reachable from the egress container.
RECORDING_TEMPLATE_BASE_URL=http://web:3000

# OCI Object Storage — DB backups + recording download fallback.
OCI_REGION=ap-mumbai-1
OCI_NAMESPACE=your_oci_namespace
OCI_BUCKET_NAME=your_backup_bucket
OCI_ACCESS_KEY_ID=your_oci_access_key
OCI_SECRET_ACCESS_KEY=your_oci_secret_key

# ── Payments ───────────────────────────────────────────────────────────────
# Every gateway is optional and independently configurable. One with missing
# credentials reports itself unconfigured, the router skips it, and the checkout
# screen simply never offers the methods only it could serve. With none set the
# API still boots — the catalogue and billing history read fine and a checkout
# attempt is a clean 503.
PAYMENTS_ENABLED=true
# Selects provider hostnames only. Sandbox and live keys behave identically.
PAYMENTS_MODE=sandbox
PAYMENTS_DEFAULT_CURRENCY=INR
# An unpaid order stops accepting payments after this long.
PAYMENTS_ORDER_TTL_MINUTES=30
PAYMENTS_HTTP_TIMEOUT_MS=15000
# Rolling window the provider-health numbers are computed over, plus the bar a
# gateway has to fall below (with enough samples) before it drops out of
# routing. Too few samples never condemns a gateway.
PAYMENTS_HEALTH_WINDOW_HOURS=24
PAYMENTS_HEALTH_MIN_SUCCESS_RATE=40
PAYMENTS_HEALTH_MIN_SAMPLES=10
# Order number prefix (invoice prefixes are set in Admin > Invoices) + what is printed on a receipt. Nothing is invented when
# the seller fields are unset — the receipt simply omits them.
PAYMENTS_INVOICE_PREFIX=NEXA
PAYMENTS_SELLER_NAME=
PAYMENTS_SELLER_ADDRESS=
PAYMENTS_SELLER_TAX_ID=
PAYMENTS_TAX_LABEL=GST

# Razorpay — primary Indian gateway (UPI, cards, net banking, wallets).
# Dashboard -> Account & Settings -> API Keys, and -> Webhooks for the secret.
# Webhook URL: https://<api-host>/payments/webhooks/razorpay
# Subscribe to: payment.captured, payment.failed, payment.authorized,
#               refund.processed, refund.failed, subscription.*
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree — secondary Indian gateway / UPI failover.
# Merchant dashboard -> Developers -> API Keys; webhook secret is the same page.
# Webhook URL: https://<api-host>/payments/webhooks/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2023-08-01

# Stripe — international cards, Apple Pay / Google Pay, multi-currency.
# Only the PUBLISHABLE key is ever sent to a browser; the secret never is.
# Webhook URL: https://<api-host>/payments/webhooks/stripe
# Subscribe to: checkout.session.completed, checkout.session.expired,
#               payment_intent.succeeded, payment_intent.payment_failed,
#               charge.refunded, customer.subscription.*, invoice.payment_failed
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20

# ── Sentry (error reporting, optional) ───────────────────────────────────────
# Unset sends nothing. Usually left empty locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Only for a one-off `ts-node prisma/seed-prod.ts`: password for the accounts it
# creates (12+ chars). Existing accounts keep theirs. Never commit a real value.
# SEED_PROD_PASSWORD=
