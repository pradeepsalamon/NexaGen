{
  "_note": "Invocation strings below are VERIFIED against the CLIs installed on this box (2026-09-03), not the flags assumed in the v2 spec. See _corrections for what changed and why.",
  "claude": {
    "cli": "claude",
    "runner": "agents/claude/run.sh",
    "invoke": "claude -p --output-format json --permission-mode bypassPermissions --add-dir {{REPO_PATH}} --max-budget-usd {{MAX_BUDGET_USD}} < {{PROMPT_FILE}}",
    "invoke_streaming": "claude -p --input-format stream-json --output-format stream-json --include-partial-messages --permission-mode bypassPermissions --add-dir {{REPO_PATH}}",
    "session_mode": "fresh_per_task",
    "supports_token_accounting": true,
    "context_window_tokens": 200000,
    "context_budget_pct": 50,
    "max_budget_usd": 8,
    "timeout_seconds": 2400,
    "enforces_json_schema": false,
    "default_model": "sonnet",
    "models": [
      {
        "id": "sonnet",
        "label": "Claude 3.7 Sonnet (Standard)"
      },
      {
        "id": "haiku",
        "label": "Claude 3.5 Haiku (Fast & Light)"
      },
      {
        "id": "opus",
        "label": "Claude Opus (Deep Reasoning)"
      }
    ]
  },
  "antigravity": {
    "cli": "agy",
    "runner": "agents/antigravity/run.sh",
    "invoke": "agy -p {{PROMPT}} --model gemini-3.1-pro-high --effort high --output-format json --json-schema {{RESULT_SCHEMA}} --dangerously-skip-permissions --print-timeout 40m",
    "session_mode": "fresh_per_task",
    "supports_token_accounting": false,
    "context_window_tokens": null,
    "context_budget_pct": null,
    "timeout_seconds": 2700,
    "enforces_json_schema": true,
    "default_model": "gemini-3.1-pro-high",
    "permission_flag": "--dangerously-skip-permissions",
    "models": [
      {
        "id": "gemini-3.8-flash-low",
        "label": "Gemini 3.8 Flash (Ultra Fast ~15s)"
      },
      {
        "id": "gemini-3.8-flash-high",
        "label": "Gemini 3.8 Flash (Fast High Effort)"
      },
      {
        "id": "gemini-3.1-pro-low",
        "label": "Gemini 3.1 Pro (Fast Pro)"
      },
      {
        "id": "gemini-3.1-pro-high",
        "label": "Gemini 3.1 Pro (Deep Reasoning)"
      }
    ]
  },
  "opencode": {
    "cli": "opencode",
    "runner": "agents/opencode/run.sh",
    "invoke": "opencode run --format json --auto --dir {{REPO_PATH}} {{PROMPT}}",
    "session_mode": "fresh_per_task",
    "supports_token_accounting": false,
    "context_window_tokens": null,
    "context_budget_pct": null,
    "timeout_seconds": 2400,
    "enforces_json_schema": false,
    "permission_flag": "--auto",
    "default_model": "default",
    "models": [
      {
        "id": "default",
        "label": "OpenCode Default"
      }
    ]
  },
  "_corrections": {
    "claude": "--max-turns does not exist in this build; bounded with --max-budget-usd instead. -p takes prompt text (or stdin), never a file path.",
    "antigravity": "No --headless / --input flags. Uses -p/--print with --output-format json. settings.json permissions are ignored in print mode, so --dangerously-skip-permissions is required and safety is enforced by agents/_lib/guard.sh instead.",
    "opencode": "No --headless / --input flags. Uses 'run' subcommand with --format json and --auto for permissions."
  }
}
