generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COACH
  STUDENT
}

enum UserStatus {
  ACTIVE
  PENDING
  ARCHIVED
  DELETED
}

enum ReferralSource {
  ADS
  FRIEND
  SCHOOL
  OTHER
}

// Normalized acquisition channel captured at registration (User.acquisitionSource).
// UNKNOWN covers legacy rows and anyone who skipped the question — analytics never
// fabricates a source, it reports UNKNOWN.
enum AcquisitionSource {
  WEBSITE
  GOOGLE
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  WHATSAPP
  REFERRAL
  SCHOOL
  COACH_REFERRAL
  ADVERTISEMENT
  OTHER
  UNKNOWN
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CoachTitle {
  NONE
  CM
  FM
  IM
  GM
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  IN_PROGRESS
}

enum BatchScheduleStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum AttendanceStatus {
  PRESENT
  LATE
  PARTIAL
  ABSENT
}

enum AttendanceEventType {
  JOIN
  LEAVE
  DISCONNECT
  RECONNECT
  BOARD_JOIN
  BOARD_LEAVE
}

// Same value set as the pre-existing TS enum in
// apps/api/src/live-class/types/live-class.types.ts, which now re-exports
// this. Replaces LiveSession.status's untyped String (P0 reliability Phase 1).
enum LiveSessionStatus {
  SCHEDULED
  WAITING
  LIVE
  ENDED
  CANCELLED
}

enum AssignmentDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// The interactive activity an assignment asks the student to do. Existing rows
// predate this column and default to REPLAY (the legacy PGN-viewer behaviour).
enum AssignmentActivityType {
  REPLAY
  SOLVE_LINE
  PLAY_VS_ENGINE
  FREE_ANALYSIS
}

// Lifecycle of one StudentAssignmentAttempt.
enum AssignmentAttemptStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  ABANDONED
}

// Visibility of a reusable pre-class settings preset.
enum LiveClassPresetScope {
  PERSONAL // visible only to ownerId
  ORG // visible to every coach; managed by admins
}

// ── Puzzle library ──

// The kind of task a puzzle asks the solver to perform. Extensible; the solver
// treats every type the same (play the solution line) — the label is guidance.
enum PuzzleType {
  TACTICAL
  CHECKMATE
  BEST_MOVE
  CALCULATION
  ENDGAME
  OPENING
  CUSTOM
}

enum PuzzleDifficulty {
  BEGINNER
  EASY
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// Puzzle lifecycle. ARCHIVED is a reversible "retired" state (distinct from a
// soft delete, which routes through the Trash module).
enum PuzzleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// GLOBAL = admin-authored, available to every coach. PRIVATE = coach-authored,
// visible to the author + admins only. Coaches cannot create GLOBAL puzzles.
enum PuzzleVisibility {
  GLOBAL
  PRIVATE
}

enum PuzzleSource {
  NEXA // authored in NexaChess (every row before the Lichess catalogue)
  LICHESS
}

enum PuzzleAttemptContext {
  DIRECT // /student/puzzles/:id, course module
  LIVE_CLASS // started from a live-class assignment (liveClassId set)
  TRAINING // served by student training
}

// Lifecycle of one PuzzleAttempt by a student.
enum PuzzleAttemptStatus {
  IN_PROGRESS
  SOLVED
  FAILED
  ABANDONED
}

// Lifecycle of a puzzle pushed into a live class. ENDED is terminal; a class
// only ever has one ACTIVE assignment at a time (partial unique index).
enum LiveClassPuzzleStatus {
  ACTIVE
  ENDED
}

// Course lifecycle. ARCHIVED is a reversible "retired" state (distinct from a
// soft delete, which routes through the Trash module) — mirrors PuzzleStatus.
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// What a CourseModule points at. A course never authors new content — it
// curates existing library Assignments/Puzzles into an ordered sequence.
enum CourseModuleContentType {
  ASSIGNMENT
  PUZZLE
}

//
// USER
//

model User {
  id String @id @default(cuid())

  email    String  @unique
  username String? @unique
  password String

  firstName String
  lastName  String?

  phoneNumber String?

  avatarUrl String?

  role   UserRole   @default(STUDENT)
  status UserStatus @default(PENDING)

  timezone String @default("Asia/Kolkata")

  isEmailVerified Boolean @default(false)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  // Wrong passwords since the last sign-in; the Nth sets loginLockedUntil.
  failedLoginAttempts Int       @default(0)
  loginLockedUntil    DateTime?
  // Throttled recency signal (updated at most once / 10 min by ActivityTrackingInterceptor).
  // Null = never seen since the feature shipped; analytics treats it as "unknown", not inactive.
  lastActiveAt    DateTime?
  // In-app presence: bumped by the web app's /presence/heartbeat (~15s) while
  // any tab is open. "Online" = seen within the last minute.
  lastSeenAt      DateTime?

  // ── Acquisition attribution (captured at registration; see analytics module) ──
  acquisitionSource AcquisitionSource @default(UNKNOWN)
  acquisitionDetail String? // free text for OTHER / referring coach name for COACH_REFERRAL
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  landingReferrer   String?

  createdById  String?
  createdBy    User?   @relation("UserCreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedUsers")

  studentProfile                  StudentProfile?
  coachProfile                    CoachProfile?                    @relation("UserCoachProfile")
  approvedCoaches                 CoachProfile[]                   @relation("CoachApprovedBy")
  createdBatches                  Batch[]                          @relation("BatchCreatedBy")
  coachedBatches                  BatchCoach[]                     @relation("BatchCoaches")
  studentBatches                  BatchStudent[]                   @relation("BatchStudents")
  classes                         CoachClass[]                     @relation("ClassCoach")
  createdFeedbackForms            FeedbackForm[]                   @relation("FeedbackFormCreatedBy")
  givenFeedback                   FeedbackResponse[]               @relation("FeedbackResponseStudent")
  receivedFeedback                FeedbackResponse[]               @relation("FeedbackResponseCoach")
  authSessions                    AuthSession[]
  mfa                             UserMfa?
  passwordResets                  PasswordResetToken[]
  emailVerifications              EmailVerificationToken[]
  deletedRecords                  TrashAuditLog[]                  @relation("TrashAuditDeletedBy")
  deletedStudentProfiles          StudentProfile[]                 @relation("StudentProfileDeletedBy")
  deletedCoachProfiles            CoachProfile[]                   @relation("CoachProfileDeletedBy")
  deletedBatches                  Batch[]                          @relation("BatchDeletedBy")
  deletedBatchCoaches             BatchCoach[]                     @relation("BatchCoachDeletedBy")
  deletedBatchStudents            BatchStudent[]                   @relation("BatchStudentDeletedBy")
  liveSessions                    LiveSession[]                    @relation("LiveClassCoach")
  courseProgress                  StudentCourseProgress[]          @relation("StudentCourseProgress")
  moduleProgress                  StudentModuleProgress[]          @relation("StudentModuleProgress")
  authoredCourses                 Course[]                         @relation("AuthoredCourses")
  deletedCourses                  Course[]                         @relation("CourseDeletedBy")
  deletedCourseModules            CourseModule[]                   @relation("CourseModuleDeletedBy")
  practices                       StudentPractice[]                @relation("StudentPractice")
  authoredAssignments             Assignment[]                     @relation("AuthoredAssignments")
  deployedAssignments             AssignmentBatch[]                @relation("DeployedAssignments")
  studentAssignments              StudentAssignment[]              @relation("StudentAssignments")
  createdPuzzleTopics             PuzzleTopic[]                    @relation("PuzzleTopicCreatedBy")
  deletedPuzzleTopics             PuzzleTopic[]                    @relation("PuzzleTopicDeletedBy")
  authoredPuzzles                 Puzzle[]                         @relation("AuthoredPuzzles")
  deletedPuzzles                  Puzzle[]                         @relation("PuzzleDeletedBy")
  studentPuzzleAttempts           PuzzleAttempt[]                  @relation("StudentPuzzleAttempts")
  classChangeRequests             ClassChangeRequest[]             @relation("ClassChangeRequestCoach")
  reviewedClassChangeRequests     ClassChangeRequest[]             @relation("ClassChangeRequestReviewer")
  studentProgress                 StudentProgress?                 @relation("StudentProgress")
  puzzleRatingChanges             PuzzleRatingChange[]             @relation("StudentPuzzleRatingChanges")
  assignedLivePuzzles             LiveClassPuzzleAssignment[]      @relation("LiveClassPuzzleAssignedBy")
  classLeaderboardAdjustments     LiveClassLeaderboardAdjustment[] @relation("LiveClassLeaderboardAdjustmentStudent")
  startedSimuls                   LiveClassSimul[]                 @relation("LiveClassSimulStartedBy")
  simulGames                      LiveClassSimulGame[]             @relation("LiveClassSimulGameStudent")
  startedMatchRounds              LiveClassMatchRound[]            @relation("LiveClassMatchRoundStartedBy")
  matchGamesAsWhite               LiveClassMatchGame[]             @relation("LiveClassMatchGameWhite")
  matchGamesAsBlack               LiveClassMatchGame[]             @relation("LiveClassMatchGameBlack")
  matchChallengesSent             LiveClassMatchChallenge[]        @relation("LiveClassMatchChallengeFrom")
  matchChallengesReceived         LiveClassMatchChallenge[]        @relation("LiveClassMatchChallengeTo")
  startedMovePolls                LiveClassMovePoll[]              @relation("LiveClassMovePollStartedBy")
  movePollAnswers                 LiveClassMovePollAnswer[]        @relation("LiveClassMovePollAnswerStudent")
  activities                      StudentActivity[]                @relation("StudentActivity")
  classAttendances                ClassAttendance[]
  attendanceLogs                  AttendanceLog[]                  @relation("UserAttendanceLogs")
  coachAttendances                CoachAttendance[]                @relation("CoachClassAttendance")
  coachAttendanceLogs             CoachAttendanceLog[]             @relation("UserCoachAttendanceLogs")
  chatMessages                    LiveChatMessage[]                @relation("UserLiveChatMessages")
  directChatMessages              LiveChatMessage[]                @relation("UserLiveChatDirectMessages")
  notifications                   Notification[]                   @relation("UserNotifications")
  createdBatchSchedules           BatchClassSchedule[]             @relation("BatchScheduleCreatedBy")
  scheduleRules                   BatchClassScheduleRule[]         @relation("BatchScheduleRuleCoach")
  analyticsEvents                 AnalyticsEvent[]                 @relation("UserAnalyticsEvents")
  liveClassPresets                LiveClassPreset[]                @relation("UserLiveClassPresets")
  messagingRuleUpdates            MessagingRule[]                  @relation("MessagingRuleUpdatedBy")
  messageDeliveries               MessageDelivery[]                @relation("UserMessageDeliveries")
  createdAnnouncements            Announcement[]                   @relation("AnnouncementCreatedBy")
  orders                          Order[]                          @relation("UserOrders")
  payments                        Payment[]                        @relation("UserPayments")
  subscriptions                   Subscription[]                   @relation("UserSubscriptions")
  invoices                        Invoice[]                        @relation("UserInvoices")
  creditNotes                     CreditNote[]                     @relation("UserCreditNotes")
  billingProfile                  BillingProfile?                  @relation("UserBillingProfile")
  chessAppearancePreference       UserChessAppearancePreference?   @relation("UserChessAppearancePreference")
  typographyPreference            UserTypographyPreference?        @relation("UserTypographyPreference")
  invoiceAuditActions             InvoiceAuditLog[]                @relation("InvoiceAuditActor")
  invoiceSettingUpdates           InvoiceSettings[]                @relation("InvoiceSettingsUpdatedBy")
  entitlements                    Entitlement[]                    @relation("UserEntitlements")
  manualPaymentsRecorded          ManualPaymentRecord[]            @relation("ManualPaymentRecordedBy")
  manualPaymentsReviewed          ManualPaymentRecord[]            @relation("ManualPaymentReviewedBy")
  requestedRefunds                Refund[]                         @relation("RefundRequestedBy")
  paymentSettingUpdates           PaymentSetting[]                 @relation("PaymentSettingUpdatedBy")
  createdDiscounts                Discount[]                       @relation("DiscountCreatedBy")
  discountRedemptions             DiscountRedemption[]             @relation("DiscountRedemptions")
  liveClassWaitingRequests        LiveClassWaitingParticipant[]    @relation("LiveClassWaitingStudent")
  liveClassWaitingResolutions     LiveClassWaitingParticipant[]    @relation("LiveClassWaitingResolvedBy")
  liveClassPullsReceived          LiveClassPull[]                  @relation("LiveClassPullStudent")
  liveClassPullsSent              LiveClassPull[]                  @relation("LiveClassPullRequestedBy")
  liveClassScreenShareRequests    LiveClassScreenShareRequest[]    @relation("LiveClassScreenShareStudent")
  liveClassScreenShareResolutions LiveClassScreenShareRequest[]    @relation("LiveClassScreenShareResolvedBy")

  // ── Coach payroll ──
  cancelledClasses                 CoachClass[]               @relation("ClassCancelledBy")
  invitedDemoRegistrations         DemoClassRegistration[]    @relation("DemoRegistrationInvitedBy")
  coachedDemoSchedules             DemoSchedule[]             @relation("DemoScheduleCoach")
  createdDemoSchedules             DemoSchedule[]             @relation("DemoScheduleCreatedBy")
  coachCompensationProfile         CoachCompensationProfile?  @relation("CoachCompensationProfile")
  createdCoachCompensationProfiles CoachCompensationProfile[] @relation("CoachCompensationProfileCreatedBy")
  coachCompensationRates           CoachCompensationRate[]    @relation("CoachCompensationRate")
  createdCoachCompensationRates    CoachCompensationRate[]    @relation("CoachCompensationRateCreatedBy")
  createdPayrollRules              PayrollRule[]              @relation("PayrollRuleCreatedBy")
  createdPayrollPeriods            PayrollPeriod[]            @relation("PayrollPeriodCreatedBy")
  approvedPayrollPeriods           PayrollPeriod[]            @relation("PayrollPeriodApprovedBy")
  finalizedPayrollPeriods          PayrollPeriod[]            @relation("PayrollPeriodFinalizedBy")
  coachPayrollRecords              CoachPayrollRecord[]       @relation("CoachPayrollRecordCoach")
  createdPayrollAdjustments        PayrollAdjustment[]        @relation("PayrollAdjustmentCreatedBy")
  reversedPayrollAdjustments       PayrollAdjustment[]        @relation("PayrollAdjustmentReversedBy")
  adminCoachPayouts                CoachPayout[]              @relation("CoachPayoutAdmin")

  // ── Academy leads CRM ──
  leadActivities LeadActivity[] @relation("LeadActivityCreatedBy")
  leadNotes      LeadNote[]     @relation("LeadNoteCreatedBy")

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  isDeleted                Boolean                  @default(false)
  deletedAt                DateTime?
  deletedById              String?
  deletedBy                User?                    @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedUsers             User[]                   @relation("UserDeletedBy")
  deleteGroupId            String?
  recordingWatchProgresses RecordingWatchProgress[]

  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([acquisitionSource])
  @@map("users")
}

//
// STUDENT PROFILE
//

model StudentProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth DateTime?

  chessRating Int?
  fideId      String?

  experienceLevel ExperienceLevel @default(BEGINNER)
  referralSource  ReferralSource  @default(OTHER)

  parentName  String
  parentEmail String?
  parentPhone String?

  parentRelationship String?

  enrolledAt DateTime @default(now())

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("StudentProfileDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("student_profiles")
}

//
// COACH PROFILE
//

model CoachProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("UserCoachProfile", fields: [userId], references: [id], onDelete: Cascade)

  title CoachTitle @default(NONE)

  bio String?

  qualification String?

  fideId     String?
  fideRating Int?

  specialization String?

  yearsOfExperience Int?

  hourlyRate Decimal? @db.Decimal(10, 2)

  approvalStatus UserStatus @default(PENDING)

  approvedById String?
  approvedBy   User?   @relation("CoachApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("CoachProfileDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("coach_profiles")
}

//
// AUTH SESSION
//

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String

  userAgent String?
  ipAddress String?

  // One device's rotation chain: the first session's id. Null on rows created
  // before families existed — treat as the row's own id.
  familyId String?

  expiresAt DateTime
  // Superseded by a successor during a normal refresh. Distinct from
  // revokedAt (logout / password reset / reuse), which is never revived.
  rotatedAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("auth_sessions")
}

// TOTP second factor. One row per enrolled (or enrolling) user.
model UserMfa {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AES-256-GCM with MFA_ENCRYPTION_KEY; never stored or logged in clear.
  secretEncrypted    String
  // Null while enrollment is pending (secret issued, first code not yet confirmed).
  enabledAt          DateTime?
  // Last accepted 30s time step, so a code can't be replayed inside its window.
  lastUsedStep       Int?
  // sha256 of each unused single-use recovery code.
  recoveryCodeHashes String[]  @default([])
  // Wrong codes since the last success or lockout; per account, so guesses
  // spread across many IPs still count together.
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_mfa")
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

//
// BATCHES
//

model Batch {
  id String @id @default(cuid())

  name          String
  description   String?
  scheduleNotes String?

  status BatchStatus @default(ACTIVE)

  startsAt DateTime? @db.Date
  endsAt   DateTime? @db.Date

  // Layer 3 pre-class defaults (partial LiveClassSettingsOverride blob; null =
  // inherit system defaults). Validated by the shared Zod schema in
  // `@nexa-chess/types`, never queried by key.
  liveClassSettings Json?

  /// Students of this batch may self-train on the puzzle catalogue (decision D0
  /// in docs/PUZZLE_CATALOGUE_IMPLEMENTATION_SPEC.md). Off by default.
  puzzleTrainingEnabled Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  coaches             BatchCoach[]
  students            BatchStudent[]
  classes             CoachClass[]
  liveSessions        LiveSession[]
  assignments         AssignmentBatch[]
  schedules           BatchClassSchedule[]
  announcements       Announcement[]       @relation("BatchAnnouncements")
  plans               Plan[]               @relation("PlanBatch")
  entitlements        Entitlement[]        @relation("EntitlementBatch")
  classChangeRequests ClassChangeRequest[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("BatchDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([status])
  @@index([createdById])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("batches")
}

model BatchCoach {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("BatchCoaches", fields: [coachId], references: [id], onDelete: Cascade)

  assignedAt    DateTime  @default(now())
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("BatchCoachDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@unique([batchId, coachId])
  @@index([coachId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("batch_coaches")
}

model BatchStudent {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("BatchStudents", fields: [studentId], references: [id], onDelete: Cascade)

  enrolledAt    DateTime  @default(now())
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("BatchStudentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("batch_students")
}

model TrashAuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  user      User?    @relation("TrashAuditDeletedBy", fields: [userId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("trash_audit_logs")
}

//
// CLASSES
//

model CoachClass {
  id String @id @default(cuid())

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("ClassCoach", fields: [coachId], references: [id], onDelete: Cascade)

  isDemo         Boolean             @default(false)
  /// Who may join a demo class (ignored for batch classes).
  demoAccessMode DemoClassAccessMode @default(PUBLIC)
  /// Shared with guests by the admin, so stored readable; required for PASSCODE.
  demoPasscode   String?
  /// The static demo schedule that generated this occurrence, if any.
  demoScheduleId String?
  demoSchedule   DemoSchedule?       @relation(fields: [demoScheduleId], references: [id], onDelete: SetNull)

  title       String?
  topic       String?
  description String?
  objectives  String?
  homework    String?
  notes       String?

  status ClassStatus @default(SCHEDULED)

  startsAt DateTime
  endsAt   DateTime

  meetingRoomId String?

  // Layer 2 pre-class config (partial LiveClassSettingsOverride blob; null =
  // inherit batch/system). Resolved + frozen onto LiveSession at class start.
  liveClassSettings Json?

  // ── Recurring-schedule linkage (all nullable; manual classes leave them null) ──
  scheduleId     String?
  schedule       BatchClassSchedule?     @relation("BatchScheduleClasses", fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleRuleId String?
  scheduleRule   BatchClassScheduleRule? @relation("BatchScheduleRuleClasses", fields: [scheduleRuleId], references: [id], onDelete: SetNull)
  // Local calendar day of the occurrence in the schedule's timezone.
  occurrenceDate DateTime?               @db.Date
  // Chronological class number within the owning schedule (stable once assigned).
  sessionNumber  Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  // Who cancelled the class and why — needed for payroll cancellation rules
  // (coach-cancels vs student-cancels vs admin-cancels pay differently).
  // Nullable: most existing/uncancelled classes never set these.
  cancelledById      String?
  cancelledBy        User?   @relation("ClassCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationReason String?

  liveSession              LiveSession?                     @relation("LiveSessionSchedule")
  attendances              ClassAttendance[]
  coachAttendance          CoachAttendance?
  recordingWatchProgresses RecordingWatchProgress[]
  puzzleAssignments        LiveClassPuzzleAssignment[]
  leaderboardAdjustments   LiveClassLeaderboardAdjustment[]
  simuls                   LiveClassSimul[]
  matchRounds              LiveClassMatchRound[]
  movePolls                LiveClassMovePoll[]
  demoRegistrations        DemoClassRegistration[]
  assignedLeads            Lead[]                           @relation("LeadAssignedClass")
  feedbackResponses        FeedbackResponse[]               @relation("FeedbackResponseClass")
  changeRequests           ClassChangeRequest[]

  @@unique([scheduleId, occurrenceDate, scheduleRuleId], map: "classes_schedule_occurrence_unique")
  @@unique([demoScheduleId, startsAt])
  @@index([batchId])
  @@index([coachId])
  @@index([status])
  @@index([startsAt])
  @@index([isDemo])
  @@index([scheduleId])
  @@index([batchId, startsAt])
  @@map("classes")
}

enum DemoRegistrationContactMethod {
  PHONE
  EMAIL
}

enum DemoClassAccessMode {
  PUBLIC
  PASSCODE
  INVITE_ONLY
}

enum DemoRegistrationSource {
  SELF
  LEAD
  INVITE
}

/// Only an uninvited guest of an INVITE_ONLY class is ever PENDING — the coach
/// admits or denies them from the in-room waiting list.
enum DemoGuestApproval {
  APPROVED
  PENDING
  DENIED
}

/// A recurring demo slot ("Trial class, Tue/Thu/Sat 5 PM") behind one
/// permanent link, `/demo/<slug>`, which always resolves to the live or next
/// occurrence. Occurrences are ordinary demo `CoachClass` rows, generated
/// ahead by `DemoScheduleService`; not soft-deletable.
model DemoSchedule {
  id              String              @id @default(cuid())
  slug            String              @unique
  topic           String
  description     String?
  coachId         String
  coach           User                @relation("DemoScheduleCoach", fields: [coachId], references: [id], onDelete: Restrict)
  timezone        String              @default("Asia/Kolkata")
  /// `DemoScheduleSlot[]` — `{ dayOfWeek: 0-6, startTime: "HH:MM" }` in `timezone`.
  slots           Json
  durationMinutes Int                 @default(60)
  accessMode      DemoClassAccessMode @default(PUBLIC)
  passcode        String?
  isActive        Boolean             @default(true)
  createdById     String?
  createdBy       User?               @relation("DemoScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  classes CoachClass[]

  @@index([isActive])
  @@map("demo_schedules")
}

/// A visitor's sign-up for a demo class, captured in place of a full account —
/// name plus a phone number or email (never both required). One row per unique
/// contact per class, so a retried/auto-polled join never re-registers or
/// re-sends the confirmation message. `joinedAt` is set once the guest actually
/// connects to the LiveKit room (the class is live); a registration with a null
/// `joinedAt` means they signed up ahead of the class starting.
model DemoClassRegistration {
  id            String                        @id @default(cuid())
  classId       String
  class         CoachClass                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name          String
  contactMethod DemoRegistrationContactMethod
  /// Normalized (digits-only phone, or lowercased email) — the dedupe key.
  contactValue  String
  phoneNumber   String?
  email         String?
  /// SELF = the guest registered on the join page; LEAD / INVITE = an admin
  /// assigned them. Any row admits its contact, whatever the access mode.
  source        DemoRegistrationSource        @default(SELF)
  leadId        String?
  lead          Lead?                         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  invitedById   String?
  invitedBy     User?                         @relation("DemoRegistrationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  /// Personal-link secret (`/demo/<classId>?invite=<token>`) for admin-added guests.
  inviteToken   String?                       @unique
  approval      DemoGuestApproval             @default(APPROVED)
  approvalAt    DateTime?
  joinedAt      DateTime?
  createdAt     DateTime                      @default(now())

  @@unique([classId, contactMethod, contactValue])
  @@index([classId])
  @@index([leadId])
  @@map("demo_class_registrations")
}

//
// ACADEMY LEADS CRM (public marketing site "book a demo" inquiries)
//

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  DEMO_SCHEDULED
  DEMO_ATTENDED
  FOLLOW_UP
  PAYMENT_PENDING
  CONVERTED
  ACTIVE_STUDENT
  LOST
}

/// A pre-signup marketing-site visit, keyed by a first-party cookie pair
/// (visitor id + session id). Captures UTM/referrer/click-id attribution so a
/// `Lead` created later in the same session can be traced back to a campaign.
/// Upserted on every tracked page view — `pageViews`/`lastVisit` advance on
/// repeat hits, everything else is set once on the first hit of a session.
model VisitorSession {
  id        String @id @default(cuid())
  sessionId String @unique
  visitorId String

  ipAddress  String?
  userAgent  String?
  browser    String?
  os         String?
  deviceType String?

  referrer    String?
  landingPage String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  fbclid String?
  gclid  String?

  firstVisit DateTime @default(now())
  lastVisit  DateTime @updatedAt
  pageViews  Int      @default(1)

  leads Lead[]

  @@index([visitorId])
  @@index([lastVisit])
  @@map("visitor_sessions")
}

/// A "book a demo" inquiry from the academy marketing page — upstream of
/// `DemoClassRegistration`: a lead is a prospect an admin/coach triages
/// (contacts, schedules an actual demo, converts to an enrolled student),
/// not yet a signup for a specific scheduled class.
model Lead {
  id              String @id @default(cuid())
  studentName     String
  parentName      String
  studentAge      Int
  experienceLevel String
  phone           String

  status   LeadStatus @default(NEW)
  /// First-touch attribution, derived from the linked `VisitorSession` at
  /// creation time (utmSource, else referrer, else "Organic").
  source   String?
  campaign String?

  lastActivityAt DateTime?
  convertedAt    DateTime?

  visitorSessionId String?
  visitorSession   VisitorSession? @relation(fields: [visitorSessionId], references: [id], onDelete: SetNull)

  /// The demo class slot this lead has been booked into, if any (admin
  /// action — see LeadService.assignDemoClass). Mirrored into a real
  /// `DemoClassRegistration` on that class so attendance/join flow works the
  /// same as a self-registered guest.
  assignedClassId String?
  assignedClass   CoachClass? @relation("LeadAssignedClass", fields: [assignedClassId], references: [id], onDelete: SetNull)

  activities        LeadActivity[]
  notes             LeadNote[]
  demoRegistrations DemoClassRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([visitorSessionId])
  @@index([assignedClassId])
  @@map("leads")
}

/// Timeline entry on a `Lead` — system-generated (registration, status
/// change) or staff-authored (mirrors a `LeadNote`). `createdById` is null
/// for system entries.
model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  activityType String
  title        String
  description  String?

  createdById String?
  createdBy   User?    @relation("LeadActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

model LeadNote {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  note String

  createdById String?
  createdBy   User?    @relation("LeadNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@map("lead_notes")
}

//
// BATCH RECURRING CLASS SCHEDULES
//

/// The recurrence template for a batch's weekly classes. Generating it produces
/// real `CoachClass` rows (one per occurrence) that behave exactly like
/// manually-created classes for live-class, attendance, assignments, etc.
model BatchClassSchedule {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  title    String
  /// IANA timezone the wall-clock rule times are interpreted in.
  timezone String @default("Asia/Kolkata")

  /// Local calendar days (inclusive) the recurrence spans.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  status BatchScheduleStatus @default(ACTIVE)

  createdById String?
  createdBy   User?   @relation("BatchScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  rules      BatchClassScheduleRule[]
  exceptions BatchScheduleException[]
  classes    CoachClass[]             @relation("BatchScheduleClasses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([status])
  @@map("batch_class_schedules")
}

/// One weekly slot in a schedule: "every <dayOfWeek> from <startTime> to
/// <endTime> with <coach>".
model BatchClassScheduleRule {
  id String @id @default(cuid())

  scheduleId String
  schedule   BatchClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday (JS getUTCDay convention).
  dayOfWeek Int
  /// "HH:MM" 24h wall-clock in the schedule's timezone.
  startTime String
  endTime   String

  coachId String
  coach   User   @relation("BatchScheduleRuleCoach", fields: [coachId], references: [id], onDelete: Cascade)

  isEnabled Boolean @default(true)

  classes CoachClass[] @relation("BatchScheduleRuleClasses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
  @@index([coachId])
  @@map("batch_class_schedule_rules")
}

/// A single local date excluded from a schedule (holiday / batch break). The
/// recurrence rule stays intact; only generation skips the date.
model BatchScheduleException {
  id String @id @default(cuid())

  scheduleId String
  schedule   BatchClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  date   DateTime @db.Date
  reason String?

  createdAt DateTime @default(now())

  @@unique([scheduleId, date])
  @@index([scheduleId])
  @@map("batch_schedule_exceptions")
}

model ClassAttendance {
  id String @id @default(cuid())

  classId String
  class   CoachClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status   AttendanceStatus @default(PRESENT)
  joinedAt DateTime?        @default(now())
  leftAt   DateTime?

  totalDuration     Int? // Total seconds actually in class
  attendancePercent Float? // 0-100 calculated percentage
  reconnectCount    Int       @default(0)
  lastActivity      DateTime?
  // Last heartbeat ping from the client (POST /live-class/:id/heartbeat),
  // fallback presence signal when a LiveKit webhook is lost. Null until the
  // client starts sending heartbeats; the timeout sweep only ever acts on
  // non-null values (P0 reliability Phase 1).
  lastHeartbeatAt   DateTime?

  logs AttendanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@map("class_attendance")
}

model AttendanceLog {
  id String @id @default(cuid())

  attendanceId String
  attendance   ClassAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserAttendanceLogs", fields: [userId], references: [id], onDelete: Cascade)

  eventType AttendanceEventType
  timestamp DateTime            @default(now())

  sessionStart    DateTime?
  sessionEnd      DateTime?
  sessionDuration Int? // seconds for this segment

  reason    String? // disconnect reason from LiveKit
  userAgent String?
  ipAddress String?
  source    String  @default("LIVEKIT") // LIVEKIT, MANUAL, SYSTEM

  // Per-tab id (LiveKit identity suffix, `joinedSession.ts#getTabClientId`).
  // Null for older rows and non-webhook sources. Lets a LEAVE/DISCONNECT close
  // only the tab that actually sent it instead of whichever session happens to
  // be open, so a second concurrent tab of the same student isn't wrongly
  // closed out from under it (P0 reliability Phase 4, RELIABILITY_DESIGN.md §2.8).
  clientId String?

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
  // Serves the "find the still-open session" lookup on every join/leave webhook.
  @@index([attendanceId, eventType, sessionEnd], map: "attendance_logs_open_session_idx")
  @@map("attendance_logs")
}

model CoachAttendance {
  id String @id @default(cuid())

  classId String     @unique
  class   CoachClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("CoachClassAttendance", fields: [coachId], references: [id], onDelete: Cascade)

  status   AttendanceStatus @default(PRESENT)
  joinedAt DateTime?        @default(now())
  leftAt   DateTime?

  totalDuration   Int? // Total seconds coach was in class
  boardDuration   Int? // Total seconds board was active in this class
  reconnectCount  Int       @default(0)
  lastActivity    DateTime?
  // See ClassAttendance.lastHeartbeatAt.
  lastHeartbeatAt DateTime?

  logs CoachAttendanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId])
  @@index([status])
  @@map("coach_attendance")
}

model CoachAttendanceLog {
  id String @id @default(cuid())

  attendanceId String
  attendance   CoachAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserCoachAttendanceLogs", fields: [userId], references: [id], onDelete: Cascade)

  eventType AttendanceEventType
  timestamp DateTime            @default(now())

  sessionStart    DateTime?
  sessionEnd      DateTime?
  sessionDuration Int? // seconds for this segment

  reason    String? // disconnect reason
  userAgent String?
  ipAddress String?
  source    String  @default("LIVEKIT") // LIVEKIT, MANUAL, SYSTEM

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
  @@map("coach_attendance_logs")
}

model AttendancePolicy {
  id String @id @default(cuid())

  name     String  @default("Default Policy")
  isActive Boolean @default(true)

  presentThreshold Float @default(90)
  lateThreshold    Float @default(70)
  partialThreshold Float @default(30)

  gracePeriodMinutes Int @default(5)
  minDurationMinutes Int @default(5)
  reconnectTolerance Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendance_policies")
}

//
// LIVE CLASSES
//

model LiveSession {
  id String @id @default(cuid())

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("LiveClassCoach", fields: [coachId], references: [id], onDelete: Cascade)

  classId String     @unique
  class   CoachClass @relation("LiveSessionSchedule", fields: [classId], references: [id], onDelete: Cascade)

  roomName        String  @unique
  livekitRoomName String? @unique

  status LiveSessionStatus @default(SCHEDULED)

  scheduledAt  DateTime
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?

  // ── Recording metadata (promoted out of `metadata` JSON for analytics) ──
  recordingBytes           BigInt? // file size in bytes; null = unknown / file pruned
  recordingDurationSeconds Int?
  recordingStatus          String? // RECORDING | STOPPING | COMPLETED | FAILED | PURGED_STORAGE_LIMIT
  recordingStartedAt       DateTime?
  recordingCompletedAt     DateTime?

  attendanceFinalizedAt DateTime?

  // First sweep that found the coach missing from the room; cleared when they're back.
  coachAbsentSince DateTime?

  // Frozen fully-resolved LiveClassSettings captured at class start (§38). Null
  // for sessions started before this feature — token grants fall back to the
  // pre-feature logic for those.
  effectiveSettings  Json?
  settingsSnapshotAt DateTime?

  // Durable copy of the shared board (LiveBoardState), written by the coach's
  // client so a refresh / crash can restore it. Null until the first save.
  boardState          Json?
  boardStateUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metadata Json?

  chatMessages             LiveChatMessage[]
  recordingWatchProgresses RecordingWatchProgress[]
  waitingParticipants      LiveClassWaitingParticipant[]
  pulls                    LiveClassPull[]
  screenShareRequests      LiveClassScreenShareRequest[]

  @@index([batchId])
  @@index([coachId])
  @@index([status])
  @@index([startedAt])
  @@index([endedAt])
  @@map("live_sessions")
}

enum LiveClassPullStatus {
  PENDING
  JOINED
  CANCELLED
}

/// A coach pulling a student into a live class. The student's app picks it up
/// on its next presence heartbeat (or first one after login) and joins
/// directly. Operational session state — not soft-deletable, not in Trash.
model LiveClassPull {
  id String @id @default(cuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("LiveClassPullStudent", fields: [studentId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("LiveClassPullRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  status LiveClassPullStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([liveSessionId, studentId])
  @@index([studentId, status])
  @@map("live_class_pulls")
}

enum WaitingRoomStatus {
  PENDING
  ADMITTED
  DENIED
}

/// Tracks students blocked at the door by a class's waiting-room policy
/// (`LiveClassSettings.waitingRoom`). One row per (session, student); a
/// student who is denied and later clicks "Request again" resets the same
/// row rather than creating a new one, so the coach's list never grows
/// duplicates. Operational data scoped to one LiveSession — not
/// soft-deletable, not Trash-registered, like LiveClassPuzzleAssignment.
model LiveClassWaitingParticipant {
  id String @id @default(cuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("LiveClassWaitingStudent", fields: [studentId], references: [id], onDelete: Cascade)

  status WaitingRoomStatus @default(PENDING)

  requestedAt  DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("LiveClassWaitingResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([liveSessionId, studentId])
  @@index([liveSessionId, status])
  @@map("live_class_waiting_participants")
}

enum ScreenShareRequestStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

/// A student's ask to share their screen while `LiveClassSettings.
/// student.screenShare` is DISABLED class-wide. One row per (session,
/// student); approval widens just that student's LiveKit canPublishSources
/// (LiveKitService.updateParticipantPermissions) — the class-wide policy is
/// untouched. Operational session state, like LiveClassWaitingParticipant:
/// not soft-deletable, not Trash-registered.
model LiveClassScreenShareRequest {
  id String @id @default(cuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("LiveClassScreenShareStudent", fields: [studentId], references: [id], onDelete: Cascade)

  status ScreenShareRequestStatus @default(PENDING)

  requestedAt  DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("LiveClassScreenShareResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([liveSessionId, studentId])
  @@index([liveSessionId, status])
  @@map("live_class_screen_share_requests")
}

model LiveChatMessage {
  id String @id @default(cuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("UserLiveChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  senderName String
  senderRole String?

  /// One-to-one private message when set; null is a room-wide message. The
  /// student <-> student case is rejected by the API, never merely hidden.
  recipientId String?
  recipient   User?   @relation("UserLiveChatDirectMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  message String @db.Text

  /// LiveKit's message id, so history reconciliation dedupes on identity
  /// instead of senderName+text+timestamp — which dropped a legitimately
  /// repeated short message (AUDIT M24).
  clientMessageId String?

  createdAt DateTime @default(now())

  @@index([liveSessionId])
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@index([clientMessageId])
  @@map("live_chat_messages")
}

/// Dedupe key for LiveKit webhook deliveries. LiveKit retries webhooks, and
/// without this a retried `participant_joined` / `participant_left` produced
/// duplicate RECONNECT logs and inflated durations (AUDIT M1).
model ProcessedWebhookEvent {
  id          String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("processed_webhook_events")
}

//
// PRE-CLASS SETTINGS (Layer 1 defaults + Layer 4 presets)
//

/// Singleton row holding the global default LiveClassSettings blob (Layer 1).
/// Mirrors AttendancePolicy: lazily created, admin-managed. `isActive` selects
/// the live row if more than one ever exists.
model LiveClassPolicy {
  id       String  @id @default(cuid())
  name     String  @default("Default Live Class Policy")
  isActive Boolean @default(true)

  /// Full LiveClassSettings JSON (validated by @nexa-chess/types).
  settings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("live_class_policies")
}

/// A reusable pre-class configuration a coach (PERSONAL) or admin (ORG) can
/// apply while creating/editing a class. Applying copies `settings` into the
/// class — never a live reference (§23). Not soft-deletable (like Assignment).
model LiveClassPreset {
  id String @id @default(cuid())

  ownerId String?
  owner   User?   @relation("UserLiveClassPresets", fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?

  scope     LiveClassPresetScope @default(PERSONAL)
  isSystem  Boolean              @default(false)
  isDefault Boolean              @default(false)

  /// Partial LiveClassSettingsOverride JSON (validated by @nexa-chess/types).
  settings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([scope])
  @@map("live_class_presets")
}

//
// CHESS BOARD APPEARANCE (board theme / piece set customization)
//

/// Singleton row holding the admin global default (Layer "admin-default").
/// Mirrors LiveClassPolicy: lazily created, admin-managed. Purely cosmetic —
/// never affects FEN/position/moves/game state.
model ChessAppearanceSettings {
  id       String  @id @default(cuid())
  name     String  @default("Default Chess Appearance Settings")
  isActive Boolean @default(true)

  /// Partial ChessAppearanceOverride JSON (validated by @nexa-chess/types).
  /// Empty object means "untouched" — the system default (Nexa Classic) applies.
  settings Json @default("{}")

  /// Built-in theme/piece-set/sound-theme ids an admin has disabled; excluded
  /// from the catalog and from resolution. System themes are never
  /// deletable, only toggle-able.
  disabledBoardThemeIds String[] @default([])
  disabledPieceSetIds   String[] @default([])
  disabledSoundThemeIds String[] @default([])

  /// When true, every user resolves straight to this admin default — the
  /// user layer in `resolveChessAppearance` is skipped entirely, so nobody
  /// can set a personal board/piece/sound preference until an admin unlocks.
  locked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chess_appearance_settings")
}

/// One user's personal board appearance preference. Row absence means "no
/// personal preference" — the resolver falls through to the admin/system
/// default. Not soft-deletable (cosmetic, no trash semantics needed).
model UserChessAppearancePreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserChessAppearancePreference", fields: [userId], references: [id], onDelete: Cascade)

  /// Partial ChessAppearanceOverride JSON (validated by @nexa-chess/types).
  settings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_chess_appearance_preferences")
}

/// Platform-wide font + text size default (singleton, lazily created). Not
/// soft-deletable (cosmetic, like ChessAppearanceSettings).
model TypographySettings {
  id String @id @default(cuid())

  /// Partial TypographyOverride JSON (validated by @nexa-chess/types).
  /// Empty object means "untouched" — the system default (Outfit + Nunito Sans) applies.
  settings Json @default("{}")

  /// When true, the user layer is skipped and nobody may save a personal font preference.
  locked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("typography_settings")
}

/// One user's personal font / text size preference. Row absence means "use
/// the admin/system default".
model UserTypographyPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserTypographyPreference", fields: [userId], references: [id], onDelete: Cascade)

  /// Partial TypographyOverride JSON (validated by @nexa-chess/types).
  settings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_typography_preferences")
}

//
// COURSES
//

// A curated, ordered playlist of existing library content (Assignments /
// Puzzles). Admin-authored only — no scoping field, visible to every student
// once PUBLISHED. Mirrors Puzzle's status/soft-delete shape.
model Course {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  createdById   String?
  createdBy     User?     @relation("AuthoredCourses", fields: [createdById], references: [id], onDelete: SetNull)
  publishedById String?
  publishedAt   DateTime?
  archivedById  String?
  archivedAt    DateTime?

  modules   CourseModule[]
  progress  StudentCourseProgress[]
  schedules BatchClassSchedule[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("CourseDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([status])
  @@index([createdById])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("courses")
}

// References exactly one of assignment/puzzle, matching contentType — enforced
// in the Zod schema + service (no DB CHECK constraint elsewhere in this schema
// to match). onDelete: Restrict so a hard delete of in-use library content is
// blocked rather than silently orphaning the module.
model CourseModule {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)

  contentType  CourseModuleContentType
  assignmentId String?
  assignment   Assignment?             @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  puzzleId     String?
  puzzle       Puzzle?                 @relation(fields: [puzzleId], references: [id], onDelete: Restrict)

  progress StudentModuleProgress[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("CourseModuleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([courseId, order])
  @@index([assignmentId])
  @@index([puzzleId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@map("course_modules")
}

model StudentCourseProgress {
  id              String   @id @default(cuid())
  studentId       String
  student         User     @relation("StudentCourseProgress", fields: [studentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercent Int      @default(0)
  lastOpenedAt    DateTime @default(now())

  @@unique([studentId, courseId])
  @@map("student_course_progress")
}

// One explicit completion mark per (student, module) — the numerator behind
// StudentCourseProgress.progressPercent. Not derived from StudentAssignment
// (which requires the assignment to be deployed to the student's batch via
// AssignmentBatch) or PuzzleAttempt, so both content types share one
// mechanism. Hard-cascades with its module/student — not Trash-registered,
// same category as PuzzleAttempt.
model StudentModuleProgress {
  id          String       @id @default(cuid())
  studentId   String
  student     User         @relation("StudentModuleProgress", fields: [studentId], references: [id], onDelete: Cascade)
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completedAt DateTime     @default(now())

  @@unique([studentId, moduleId])
  @@index([moduleId])
  @@map("student_module_progress")
}

//
// PRACTICE & ASSIGNMENTS
//

model Practice {
  id         String            @id @default(cuid())
  title      String
  difficulty String // BEGINNER, INTERMEDIATE, ADVANCED
  dueDate    DateTime
  students   StudentPractice[]
}

model StudentPractice {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation("StudentPractice", fields: [studentId], references: [id], onDelete: Cascade)
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  status     String // PENDING, IN_PROGRESS, COMPLETED

  @@unique([studentId, practiceId])
  @@map("student_practices")
}

// A reusable PGN assignment in the library. Admins author shared items
// (`isLibrary = true`, visible to every coach); coaches author private items
// (`isLibrary = false`, visible only to the author). Not soft-deletable — a
// delete cascades to every deployment + per-student row.
model Assignment {
  id               String               @id @default(cuid())
  createdById      String?
  createdBy        User?                @relation("AuthoredAssignments", fields: [createdById], references: [id], onDelete: SetNull)
  isLibrary        Boolean              @default(false)
  title            String
  description      String?
  pgn              String // raw PGN text (source of truth for the REPLAY board viewer)
  pgnUrl           String? // Cloudinary raw-file URL for download
  difficulty       AssignmentDifficulty @default(BEGINNER)
  timeLimitMinutes Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // ── Interactive-activity configuration (all additive; REPLAY ignores them) ──
  activityType              AssignmentActivityType @default(REPLAY)
  startFen                  String? // starting position for SOLVE_LINE / PLAY_VS_ENGINE / FREE_ANALYSIS
  solutionMovesJson         Json? // [{ uci, san }] — expected line for SOLVE_LINE (never sent to students pre-completion)
  orientation               String? // "white" | "black" — board orientation for the student
  studentColor              String? // "white" | "black" — side the student plays (SOLVE_LINE / PLAY_VS_ENGINE)
  engineLevel               Int? // Stockfish skill level 0-20 for PLAY_VS_ENGINE
  passThresholdPercent      Int                    @default(100)
  maxAttempts               Int? // null = unlimited
  allowHints                Boolean                @default(false)
  allowRetry                Boolean                @default(true)
  requiredCompletionPercent Int                    @default(100)

  deployments   AssignmentBatch[]
  courseModules CourseModule[]

  @@index([createdById])
  @@index([isLibrary])
  @@map("assignments")
}

// One deployment of a library assignment to a batch, with its own due date.
model AssignmentBatch {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  batchId      String
  batch        Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?      @relation("DeployedAssignments", fields: [assignedById], references: [id], onDelete: SetNull)
  dueDate      DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  students StudentAssignment[]

  @@unique([assignmentId, batchId])
  @@index([batchId])
  @@index([assignedById])
  @@map("assignment_batches")
}

model StudentAssignment {
  id                String           @id @default(cuid())
  assignmentBatchId String
  assignmentBatch   AssignmentBatch  @relation(fields: [assignmentBatchId], references: [id], onDelete: Cascade)
  studentId         String
  student           User             @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  status            AssignmentStatus @default(PENDING)
  completedAt       DateTime?        @map("completed_at")
  timeSpentSeconds  Int?             @map("time_spent_seconds")
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // ── Evaluated-activity progress (null for legacy REPLAY rows) ──
  bestScorePercent    Int?
  bestAccuracyPercent Int?
  attemptCount        Int       @default(0)
  lastAttemptAt       DateTime?

  attempts StudentAssignmentAttempt[]

  @@unique([assignmentBatchId, studentId])
  @@index([studentId])
  @@index([completedAt])
  @@map("student_assignments")
}

// One execution of an evaluated assignment by a student. Progress is saved
// incrementally (movesJson); the server evaluates authoritatively on submit.
model StudentAssignmentAttempt {
  id                  String                  @id @default(cuid())
  studentAssignmentId String
  studentAssignment   StudentAssignment       @relation(fields: [studentAssignmentId], references: [id], onDelete: Cascade)
  attemptNumber       Int
  status              AssignmentAttemptStatus @default(IN_PROGRESS)
  movesJson           Json                    @default("[]") // [{ ply, uci, san, fenAfter, correct?, classification?, elapsedMs? }]
  scorePercent        Int?
  accuracyPercent     Int?
  hintsUsed           Int                     @default(0)
  durationSeconds     Int                     @default(0)
  result              String? // "SOLVED" | "PARTIAL" | "WIN" | "LOSS" | "DRAW" | "SUBMITTED"
  startedAt           DateTime                @default(now())
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([studentAssignmentId, attemptNumber])
  @@index([studentAssignmentId])
  @@map("student_assignment_attempts")
}

//
// NOTIFICATIONS
//

/// Mirrors MessagingEvent — the in-app bell is one channel of a messaging rule.
enum NotificationType {
  INVOICE_ISSUED
  ASSIGNMENT_DUE_SOON
  ASSIGNMENT_GRADED
  CLASS_SCHEDULED
  CLASS_REMINDER
  CLASS_REMINDER_COACH
  CLASS_CANCELLED
  ASSIGNMENT_ASSIGNED
  ANNOUNCEMENT
  ACCOUNT_WELCOME
  ACCOUNT_APPROVED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  REFUND_PROCESSED
  SUBSCRIPTION_RENEWAL_FAILED
  PAYROLL_FINALIZED
  PAYROLL_PAID
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  /// in-app deep link, e.g. /student/assignments/<id>
  linkPath  String?
  /// idempotency key so schedulers never double-send (null = always insert)
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

//
// ACTIVITY & ANNOUNCEMENTS
//

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentActivity", fields: [studentId], references: [id], onDelete: Cascade)
  type      String // CLASS_JOINED, LESSON_COMPLETED, PRACTICE_FINISHED, FEEDBACK
  title     String
  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("student_activities")
}

model Announcement {
  id          String @id @default(cuid())
  title       String
  description String
  /// Legacy label the student dashboard feed still renders: BATCH, COURSE, PLATFORM.
  type        String

  audience AnnouncementAudience @default(EVERYONE)

  batchId String?
  batch   Batch?  @relation("BatchAnnouncements", fields: [batchId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([audience])
  @@index([batchId])
  @@index([createdAt])
  @@map("announcements")
}

model RecordingWatchProgress {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  liveSessionId  String
  watchedSeconds Int      @default(0)
  updatedAt      DateTime @updatedAt

  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class       CoachClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@map("recording_watch_progress")
}

//
// ANALYTICS
//

/// One meaningful product action by a user. Powers DAU/WAU/MAU, new-vs-returning,
/// and the engagement section. Written fire-and-forget by AnalyticsEventService —
/// a failed insert never breaks the originating request.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserAnalyticsEvents", fields: [userId], references: [id], onDelete: Cascade)
  type       String // LOGIN | CLASS_JOIN | ASSIGNMENT_ATTEMPT | RECORDING_WATCH | DASHBOARD_VIEW
  entityId   String? // class id / assignment id / etc.
  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@index([occurredAt])
  @@map("analytics_events")
}

/// Daily rollup of recording-storage usage. One row per business-timezone day,
/// written by AnalyticsScheduler. Drives the storage growth chart and forecast.
model StorageSnapshot {
  id             String   @id @default(cuid())
  capturedAt     DateTime @default(now())
  capturedDate   DateTime @unique @db.Date
  recordingBytes BigInt
  recordingCount Int
  limitBytes     BigInt

  @@index([capturedAt])
  @@map("storage_snapshots")
}

//
// PUZZLE LIBRARY
//

// A chess-training theme (Fork, Pin, Back Rank, Checkmate in 2, …). Admin-only
// authoring; every puzzle belongs to exactly one topic. Soft-deletable — the
// `name`/`slug` unique indexes are partial (`WHERE "isDeleted" = false`), added
// by hand in the migration so a deleted topic's name can be reused.
model PuzzleTopic {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  icon        String? // lucide icon name or emoji
  sortOrder   Int     @default(0)

  // Folder tree: null = a root folder.
  parentId String?
  parent   PuzzleTopic?  @relation("PuzzleTopicTree", fields: [parentId], references: [id], onDelete: SetNull)
  children PuzzleTopic[] @relation("PuzzleTopicTree")

  createdById String?
  createdBy   User?   @relation("PuzzleTopicCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  puzzles Puzzle[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("PuzzleTopicDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@index([sortOrder])
  @@index([parentId])
  @@map("puzzle_topics")
}

// A reusable chess-training object: position + solution line + topic + type +
// difficulty + ownership + lifecycle. GLOBAL puzzles are admin-authored and
// visible to every coach; PRIVATE puzzles are coach-authored and visible only to
// the author + admins. The same puzzle is referenced by a
// LiveClassPuzzleAssignment (in-class deployment) without being copied.
model Puzzle {
  id          String      @id @default(cuid())
  topicId     String
  topic       PuzzleTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  /// COLLATE "natural_sort" (ICU, numeric) — set by migration
  /// 20261003190000_puzzle_title_natural_collation, which Prisma cannot express.
  /// ORDER BY title is natural order ("Puzzle 2" before "Puzzle 10").
  title       String
  description String?

  puzzleType PuzzleType
  difficulty PuzzleDifficulty

  fen               String // starting position (the position the solver sees)
  solutionMovesJson Json     @default("[]") // [{ uci, san }] — the expected line
  explanation       String?
  hintsJson         Json? // string[] — progressive text hints
  tags              String[] @default([])
  estimatedSeconds  Int?
  /// This puzzle's own points / penalties override (PuzzleScoringOverride,
  /// validated by @nexa-chess/types). null = the admin default applies.
  scoringJson       Json?

  /// Origin of the puzzle; (source, sourceId) is unique across soft-deleted
  /// rows, so a Lichess puzzle is materialised at most once, ever.
  source       PuzzleSource @default(NEXA)
  sourceId     String? // LichessPuzzle.id when source = LICHESS (no FK: the catalogue is reloadable)
  /// NexaChess-owned difficulty rating; null ⇒ PUZZLE_DIFFICULTY_RATINGS[difficulty].
  rating       Int?
  /// Opponent move that produced `fen` (Lichess moves[0]); display only.
  setupMoveUci String?
  /// puzzleContentHash(fen, solution) — identity of content, never unique.
  /// Set by every write path that touches fen or the solution.
  contentHash  String?

  status     PuzzleStatus     @default(DRAFT)
  visibility PuzzleVisibility @default(PRIVATE)

  createdById   String?
  createdBy     User?     @relation("AuthoredPuzzles", fields: [createdById], references: [id], onDelete: SetNull)
  createdByRole UserRole // snapshot so the "Admin" vs coach label survives author deletion
  updatedById   String?
  publishedById String?
  publishedAt   DateTime?
  archivedById  String?
  archivedAt    DateTime?

  attempts        PuzzleAttempt[]
  liveAssignments LiveClassPuzzleAssignment[]
  courseModules   CourseModule[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("PuzzleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteGroupId String?

  @@unique([source, sourceId], map: "puzzles_source_sourceId_key")
  @@index([topicId])
  @@index([createdById])
  @@index([puzzleType])
  @@index([difficulty])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([deleteGroupId])
  @@index([contentHash])
  @@map("puzzles")
}

// One solve attempt by a student. Progress is saved incrementally (movesJson);
// the server evaluates authoritatively on submit. `liveClassId` holds the
// `CoachClass.id` when the attempt was started from an in-class puzzle
// assignment (see LiveClassPuzzleAssignment) — no FK, stays set after the class.
// The live leaderboard reads `{ liveClassId, puzzleId }`; if the same puzzle is
// assigned twice in one class the rounds merge (acceptable — an `assignmentId`
// column can split them later if needed).
model PuzzleAttempt {
  id        String @id @default(cuid())
  puzzleId  String
  puzzle    Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation("StudentPuzzleAttempts", fields: [studentId], references: [id], onDelete: Cascade)

  liveClassId String?
  context     PuzzleAttemptContext @default(DIRECT)

  attemptNumber   Int
  status          PuzzleAttemptStatus @default(IN_PROGRESS)
  movesJson       Json                @default("[]") // [{ ply, uci, san, fenAfter, correct?, … }]
  scorePercent    Int?
  accuracyPercent Int?
  hintsUsed       Int                 @default(0)
  /// Wrong moves tried, counted server-side in saveProgress (negative marks).
  wrongMoves      Int                 @default(0)
  /// The wrong moves themselves ([{ ply, uci, san, fenBefore, at }]), for the coach's live board.
  wrongMovesJson  Json                @default("[]")
  durationSeconds Int                 @default(0)
  result          String? // "SOLVED" | "FAILED"
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([puzzleId, studentId, attemptNumber])
  @@index([puzzleId])
  @@index([studentId])
  @@index([liveClassId])
  @@index([studentId, completedAt])
  @@map("puzzle_attempts")
}

// A puzzle a coach pushed into a live class. References `puzzleId` — never
// copies it. Lightweight and per-class, so it is NOT soft-deletable / not
// registered with the Trash module (same call as Assignment). Lifecycle is the
// `status` column. A partial unique index (`WHERE status = 'ACTIVE'`, added by
// hand in the migration) enforces one live puzzle per class at a time.
model LiveClassPuzzleAssignment {
  id String @id @default(cuid())

  liveClassId String
  liveClass   CoachClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  puzzleId String
  puzzle   Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Restrict)

  assignedById String?
  assignedBy   User?   @relation("LiveClassPuzzleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  status            LiveClassPuzzleStatus @default(ACTIVE)
  revealLeaderboard Boolean               @default(true)
  /// Resolved PuzzleScoring / PuzzleLeaderboardOptions, frozen at share time
  /// (null on rows shared before points existed → the defaults apply).
  scoringJson       Json?
  leaderboardJson   Json?
  /// Coach's manual +/- points: { [studentId]: number }.
  adjustmentsJson   Json                  @default("{}")
  durationSeconds   Int? // null = untimed
  startedAt         DateTime              @default(now())
  endedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([liveClassId])
  @@index([puzzleId])
  @@map("live_class_puzzle_assignments")
}

/// Coach's manual +/- points on the whole-class puzzle leaderboard, on top of
/// every puzzle's own points. Operational state — not soft-deletable.
model LiveClassLeaderboardAdjustment {
  id String @id @default(cuid())

  liveClassId String
  liveClass   CoachClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("LiveClassLeaderboardAdjustmentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  points Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([liveClassId, studentId])
  @@index([studentId])
  @@map("live_class_leaderboard_adjustments")
}

enum LiveClassSimulStatus {
  ACTIVE
  ENDED
}

enum SimulColorMode {
  WHITE
  BLACK
  ALTERNATE
}

enum SimulGameStatus {
  ONGOING
  FINISHED
}

enum SimulGameResult {
  COACH_WON
  STUDENT_WON
  DRAW
}

enum SimulEndReason {
  CHECKMATE
  STALEMATE
  INSUFFICIENT_MATERIAL
  THREEFOLD_REPETITION
  FIFTY_MOVE_RULE
  RESIGNATION
  DRAW_AGREED
  ADJUDICATED
  SIMUL_ENDED
}

enum SimulSide {
  COACH
  STUDENT
}

/// The coach plays several students at once in a live class. One ACTIVE per
/// class (partial unique index in the migration). Operational class state —
/// not soft-deletable, not Trash-registered.
model LiveClassSimul {
  id String @id @default(cuid())

  liveClassId String
  liveClass   CoachClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  startedById String?
  startedBy   User?   @relation("LiveClassSimulStartedBy", fields: [startedById], references: [id], onDelete: SetNull)

  status    LiveClassSimulStatus @default(ACTIVE)
  colorMode SimulColorMode       @default(WHITE)
  startFen  String
  startedAt DateTime             @default(now())
  endedAt   DateTime?

  games LiveClassSimulGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([liveClassId])
  @@map("live_class_simuls")
}

model LiveClassSimulGame {
  id String @id @default(cuid())

  simulId String
  simul   LiveClassSimul @relation(fields: [simulId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("LiveClassSimulGameStudent", fields: [studentId], references: [id], onDelete: Cascade)

  coachIsWhite  Boolean
  fen           String
  /// SimulMove[] (san, uci, by, engine?).
  movesJson     Json             @default("[]")
  /// Half-moves played — the optimistic-concurrency guard for every move.
  ply           Int              @default(0)
  status        SimulGameStatus  @default(ONGOING)
  result        SimulGameResult?
  endReason     SimulEndReason?
  drawOfferedBy SimulSide?
  engineMoves   Int              @default(0)
  lastMoveAt    DateTime?
  finishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([simulId, studentId])
  @@index([studentId])
  @@map("live_class_simul_games")
}

enum LiveClassMatchRoundStatus {
  ACTIVE
  ENDED
}

enum MatchPairingMode {
  AUTO
  COACH
  STUDENT_CHOICE
}

enum MatchGameStatus {
  ONGOING
  FINISHED
}

enum MatchGameResult {
  WHITE_WON
  BLACK_WON
  DRAW
}

enum MatchEndReason {
  CHECKMATE
  STALEMATE
  INSUFFICIENT_MATERIAL
  THREEFOLD_REPETITION
  FIFTY_MOVE_RULE
  RESIGNATION
  DRAW_AGREED
  TIMEOUT
  ADJUDICATED
  ABORTED
  ROUND_ENDED
}

enum MatchColor {
  WHITE
  BLACK
}

enum MatchChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Students play each other in a live class while the coach monitors every
/// board. One ACTIVE per class (partial unique index in the migration).
/// Operational class state — not soft-deletable, not Trash-registered.
model LiveClassMatchRound {
  id String @id @default(cuid())

  liveClassId String
  liveClass   CoachClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  startedById String?
  startedBy   User?   @relation("LiveClassMatchRoundStartedBy", fields: [startedById], references: [id], onDelete: SetNull)

  status           LiveClassMatchRoundStatus @default(ACTIVE)
  pairingMode      MatchPairingMode
  startFen         String
  /// null = untimed.
  clockInitialMs   Int?
  clockIncrementMs Int                       @default(0)
  startedAt        DateTime                  @default(now())
  endedAt          DateTime?

  games      LiveClassMatchGame[]
  challenges LiveClassMatchChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([liveClassId])
  @@map("live_class_match_rounds")
}

model LiveClassMatchGame {
  id String @id @default(cuid())

  roundId String
  round   LiveClassMatchRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  whiteId String
  white   User   @relation("LiveClassMatchGameWhite", fields: [whiteId], references: [id], onDelete: Cascade)
  blackId String
  black   User   @relation("LiveClassMatchGameBlack", fields: [blackId], references: [id], onDelete: Cascade)

  fen           String
  /// MatchMove[] (san, uci).
  movesJson     Json             @default("[]")
  /// Half-moves played — the optimistic-concurrency guard for every move.
  ply           Int              @default(0)
  /// Remaining ms at `turnSince`; null when untimed.
  whiteClockMs  Int?
  blackClockMs  Int?
  turnSince     DateTime         @default(now())
  status        MatchGameStatus  @default(ONGOING)
  result        MatchGameResult?
  endReason     MatchEndReason?
  drawOfferedBy MatchColor?
  finishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roundId])
  @@index([whiteId])
  @@index([blackId])
  @@map("live_class_match_games")
}

model LiveClassMatchChallenge {
  id String @id @default(cuid())

  roundId String
  round   LiveClassMatchRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  fromId String
  from   User   @relation("LiveClassMatchChallengeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     User   @relation("LiveClassMatchChallengeTo", fields: [toId], references: [id], onDelete: Cascade)

  status     MatchChallengeStatus @default(PENDING)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roundId])
  @@index([toId])
  @@map("live_class_match_challenges")
}

enum LiveClassMovePollStatus {
  OPEN
  CLOSED
  ENDED
}

/// A coach's "what would you play?" question on one position.
model LiveClassMovePoll {
