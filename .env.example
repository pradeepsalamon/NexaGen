# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=nexa_chess

NODE_ENV=production

# Frontend Build Args (Must be known before running docker-compose build)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# For self-hosted LiveKit, this should point to your LiveKit domain (e.g. wss://livekit.yourdomain.com)
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.yourdomain.com

# API Runtime Variables 
JWT_ACCESS_SECRET=random_secure_access_secret
JWT_REFRESH_SECRET=random_secure_refresh_secret
CORS_ORIGIN=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# For self-hosted LiveKit, this should point to your LiveKit domain (e.g. wss://livekit.yourdomain.com)
LIVEKIT_URL=wss://livekit.yourdomain.com
# These keys are automatically passed to LiveKit via docker-compose.
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

NEXT_PUBLIC_CONTACT_EMAIL=info@yourdomain.com
ADMIN_EMAILS=admin@yourdomain.com
TRASH_RETENTION_DAYS=30
STOCKFISH_PATH=stockfish
STOCKFISH_POOL_SIZE=4
