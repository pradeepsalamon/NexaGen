{
  "name": "@nexa-chess/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "nest start --watch",
    "build": "prisma generate --schema prisma/schema.prisma && nest build",
    "build:prod": "prisma generate --schema prisma/schema.prisma && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:dev:create": "prisma migrate dev --create-only --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma --force",
    "seed": "prisma db seed --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "test:payments:integration": "node scripts/payments-integration-check.cjs",
    "test:payments:webhooks": "node scripts/payments-webhook-check.cjs",
    "test:payments:pricing": "node scripts/payments-pricing-check.cjs",
    "audit:reliability": "node scripts/reliability-reconciliation-audit.cjs",
    "puzzles:prepare": "turbo run build --filter=@nexa-chess/api --output-logs=errors-only && node scripts/lichess-puzzles-prepare.cjs"
  },
  "prisma": {
    "seed": "node prisma/seed-runner.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@livekit/protocol": "^1.49.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nexa-chess/config": "*",
    "@nexa-chess/types": "*",
    "@prisma/client": "^6.19.3",
    "@sentry/nestjs": "^11.4.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.2",
    "chess.js": "^1.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.17.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^10.1.4",
    "pdfmake": "^0.3.11",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "streamifier": "^0.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@nexa-chess/tsconfig": "^0.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/streamifier": "^0.1.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.2.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1"
  }
}
