{
  "name": "nexa-gen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:clean": "npm run clean -w apps/web && npm run clean -w apps/api && turbo dev --parallel",
    "dev:web": "turbo dev --filter=@nexa-gen/web --parallel",
    "dev:web:clean": "npm run clean -w apps/web && npm run dev -w apps/web",
    "dev:api": "turbo dev --filter=@nexa-gen/api --parallel",
    "dev:api:clean": "npm run clean -w apps/api && npm run start:dev -w apps/api",
    "build": "turbo build",
    "build:prod": "npm run build:prod -w apps/api && npm run build -w apps/web",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:migrate:dev": "npm run migrate:dev -w apps/api",
    "db:migrate:create": "npm run migrate:dev:create -w apps/api",
    "db:migrate:deploy": "npm run migrate:deploy -w apps/api",
    "db:migrate:status": "npm run migrate:status -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "turbo": "^2.5.4",
    "typescript": "^5.5.4"
  }
}
