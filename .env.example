# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=nexa_chess

NODE_ENV=production

# Frontend Build Args (Must be known before running docker-compose build)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# For self-hosted LiveKit, this should point to your LiveKit domain (e.g. wss://livekit.yourdomain.com)
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.yourdomain.com

# API Runtime Variables 
JWT_ACCESS_SECRET=random_secure_access_secret
JWT_REFRESH_SECRET=random_secure_refresh_secret
CORS_ORIGIN=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
# Cookie scope. Leave blank to auto-derive the registrable domain from FRONTEND_URL
# (e.g. ".yourdomain.com" so api.yourdomain.com and yourdomain.com share the session).
# Set explicitly for multi-part TLDs (".example.co.uk") or to override.
COOKIE_DOMAIN=
# Proxy hops in front of the API (nginx terminating TLS = 1). Controls
# X-Forwarded-For trust for rate limiting and secure-cookie detection.
TRUST_PROXY_HOPS=1

# For self-hosted LiveKit, this should point to your LiveKit domain (e.g. wss://livekit.yourdomain.com)
LIVEKIT_URL=wss://livekit.yourdomain.com
# These keys are automatically passed to LiveKit via docker-compose.
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

NEXT_PUBLIC_CONTACT_EMAIL=info@yourdomain.com
ADMIN_EMAILS=admin@yourdomain.com
TRASH_RETENTION_DAYS=30
STOCKFISH_PATH=stockfish
STOCKFISH_POOL_SIZE=4

# Local Server Storage for Recordings
# RECORDING_STORAGE_HOST_DIR is the path on the host; RECORDING_STORAGE_DIR is the
# matching path inside the api + egress containers (keep them mounted 1:1).
RECORDING_STORAGE_HOST_DIR=./recordings
RECORDING_STORAGE_DIR=/recordings
RECORDING_STORAGE_LIMIT_GB=130
# Recordings younger than this are never auto-pruned when the disk fills up.
RECORDING_MIN_RETENTION_DAYS=14
# Where egress writes a class recording. "local" (default) writes into
# RECORDING_STORAGE_DIR, which is what the quota, the retention prune, the admin
# storage analytics and the signed /recording/stream endpoint all read. Set to
# "oci" only to have egress upload straight to the bucket instead — the local
# storage subsystem then sees nothing.
RECORDING_STORAGE_TARGET=local

# OCI Object Storage — required for DB backups and the recording download
# fallback (recordings not present on local disk).
OCI_REGION=ap-mumbai-1
OCI_NAMESPACE=your_oci_namespace
OCI_BUCKET_NAME=your_backup_bucket
OCI_ACCESS_KEY_ID=your_oci_access_key
OCI_SECRET_ACCESS_KEY=your_oci_secret_key
